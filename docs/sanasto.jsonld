    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/avoin-data",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "avoin data",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "öppna data",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "open data",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "data, joka on tarjolla muille ja jota kuka tahansa saa vapaasti\nkäyttää, kierrättää, julkaista uudelleen ja levittää edelleen.\n",
          "@language": "fi"
        },
        {
          "@value": "data som är tillgängliga för andra och som vem som helst fritt\nfår använda, återanvända, publicera på nytt och vidareförmedla.\n",
          "@language": "sv"
        },
        {
          "@value": "data that are available to others and that anyone may freely\nuse, reuse, republish and redistribute.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/data"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/bi",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "liiketoimintatiedon hallinta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "verksamhetsanalys",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "business intelligence",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "BI",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "BI",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "BI",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Liiketoimintatiedon hallinta (BI) tarkoittaa prosessuaalista ja teknistä infrastruktuuria, joka kerää, tallentaa ja analysoi yrityksen toiminnan tuottamaa tietoa.",
          "@language": "fi"
        },
        {
          "@value": "Verksamhetsanalys (BI) avser den processuella och tekniska infrastruktur som samlar in, lagrar och analyserar information som genereras av företagets verksamhet.",
          "@language": "sv"
        },
        {
          "@value": "Business intelligence (BI) refers to the procedural and technical infrastructure that collects, stores and analyzes information generated by a company's operations.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Microsoft Power BI on yksi suosituista BI-ohjelmistoista, jota yritykset käyttävät tietojen analysointiin ja raportointiin.",
          "@language": "fi"
        },
        {
          "@value": "Microsoft Power BI är en av de populära BI-programvarorna som företag använder för dataanalys och rapportering.",
          "@language": "sv"
        },
        {
          "@value": "Microsoft Power BI is one of the popular BI software tools that companies use for data analysis and reporting.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Itewiki:2025",
          "@language": "fi",
          "@id": "https://www.itewiki.fi/opas/bi-business-intelligence-ja-raportointi/"
        }
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/gsrn",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "palvelusuhteen tunniste",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "globalt tjänsterelationsnummer",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Global Service Relation Number",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "GSRN",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "GSRN",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "GSRN",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "GSRN on GS1:n yksilöinnin standardi, jota käytetään antamaan palvelun asiakas-, liike- tai käyttäjäsuhteille yksilöllinen tunniste. Sen avulla voidaan tunnistaa sekä palvelun vastaanottaja että palvelun tarjoaja, ja usein nämä rekisteröidään samanaikaisesti, esimerkiksi kun tavarantoimittaja toimittaa asiakkaalle tuotteen. Palvelusuhteen osapuoli voi olla joko henkilö tai yritys. GSRN-tunnus voidaan koodata viivakoodiin tai EPC/RFID-tunnisteeseen, esimerkiksi henkilökorttiin tai sähkömittariin.",
          "@language": "fi"
        },
        {
          "@value": "GSRN är en GS1-identifieringsstandard som används för att ge en unik identifierare åt en tjänsts kund-, affärs- eller användarrelation. Med hjälp av GSRN kan man identifiera både mottagaren och leverantören av en tjänst, och dessa registreras ofta samtidigt, till exempel när en leverantör levererar en produkt till en kund. En part i en tjänsterelation kan vara antingen en person eller ett företag. Ett GSRN-nummer kan kodas i en streckkod eller i en EPC/RFID-tagg, till exempel på ett id-kort eller en elmätare.",
          "@language": "sv"
        },
        {
          "@value": "GSRN is a GS1 identification standard used to assign a unique identifier to a service's customer, business or user relationship. It can be used to identify both the recipient and the provider of a service, and these are often registered simultaneously, for example when a supplier delivers a product to a customer. A party to a service relationship can be either a person or a company. A GSRN can be encoded in a barcode or in an EPC/RFID tag, for example on an ID card or an electricity meter.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "GS1 yksilöinti standardit",
          "@language": "fi",
          "@id": "https://www.gs1.org/standards/id-keys"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/bitti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "bitti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "bit",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "binary digit",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "bit",
          "@language": "en",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bitti on informaatioteoriassa informaation määrän mitta ja tietotekniikassa tiedon tai tietovuon pienin käsiteltävä osa. Sähköisen tiedon pienin yksikkö on bitti (b), yksi merkki, joka voi saada arvon 1 tai 0.",
          "@language": "fi"
        },
        {
          "@value": "En bit är inom informationsteori ett mått på informationsmängd och inom datateknik den minsta enheten av data eller dataflöde som kan behandlas. Den minsta enheten för elektronisk information är bit (b), en symbol som kan anta värdet 1 eller 0.",
          "@language": "sv"
        },
        {
          "@value": "A bit is, in information theory, a unit of information and, in computing, the smallest unit of data or data stream that can be processed. The smallest unit of electronic information is the bit (b), a symbol that can take the value 1 or 0.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN 1556:1998",
          "@language": "fi",
          "@id": "https://sales.sfs.fi/fi/index/tuotteet/SFS/CEN/ID2/1/246564.html.stx"
        },
        {
          "@value": "ISO/IEC 19762-1:2025",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/bittitavu"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/data"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/epcis",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "EPCIS",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "EPCIS",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Electronic Product Code Information Services",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "EPCIS on GS1-standardi, joka on suunniteltu helpottamaan tapahtumatietojen luomista, tallentamista ja jakamista organisaatioiden välillä koko toimitusketjussa. EPCIS tarjoaa yhtenäisen tietorakenteen ja formaatin tapahtumien kuvaamiseen, mikä mahdollistaa tuotteiden ja omaisuuden tilan, sijainnin, liikkeiden ja alkuperän seuraamisen.",
          "@language": "fi"
        },
        {
          "@value": "EPCIS är en GS1-standard som är utformad för att underlätta skapande, lagring och delning av händelsedata mellan organisationer i hela leveranskedjan. EPCIS erbjuder en enhetlig datastruktur och ett enhetligt format för att beskriva händelser, vilket möjliggör spårning av produkters och tillgångars status, plats, rörelser och ursprung.",
          "@language": "sv"
        },
        {
          "@value": "EPCIS is a GS1 standard designed to facilitate the creation, storage and sharing of event data between organizations throughout the supply chain. EPCIS provides a uniform data structure and format for describing events, enabling tracking of the status, location, movements and origin of products and assets.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "GS1 Finland:2025",
          "@language": "fi",
          "@id": "https://gs1.fi/fi/standardit/gs1n-tiedon-jakamisen-standardit"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/ontologia",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
