    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/transaktiodata",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "transaktiodata",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "transaktionsdata",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "transactional data",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Transaktiodata syntyy yritystoiminnassa ja sisältää liiketapahtumakohtaisia tietoja. Transaktiodataa on esimerkiksi ostoista ja tilauksista saatava data.",
          "@language": "fi"
        },
        {
          "@value": "Transaktionsdata uppstår i affärsverksamheten och innehåller uppgifter kopplade till enskilda affärshändelser. Transaktionsdata kan till exempel vara data som fås från inköp och beställningar.",
          "@language": "sv"
        },
        {
          "@value": "Transactional data is generated in the course of business operations and contains information related to individual business transactions. Examples of transactional data include data obtained from purchases and orders.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastot",
          "@language": "fi",
          "@id": "https://sanastot.suomi.fi/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/lohkoketju"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/erp",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "toiminnanohjausjärjestelmä",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "affärssystem",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "enterprise resource planning",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "ERP",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "ERP",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "ERP",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Toiminnanohjausjärjestelmä on yrityksen tietojärjestelmä, joka integroi eri\ntoimintoja, esimerkiksi tuotantoa, jakelua, varastonhallintaa, laskutusta ja\nkirjanpitoa.\n",
          "@language": "fi"
        },
        {
          "@value": "Ett affärssystem är ett företags informationssystem som integrerar olika\nfunktioner, till exempel produktion, distribution, lagerhantering,\nfakturering och bokföring.\n",
          "@language": "sv"
        },
        {
          "@value": "Enterprise resource planning is a company's information system that\nintegrates different functions, such as production, distribution,\ninventory management, invoicing and accounting.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 16100-1:2009",
          "@language": "fi",
          "@id": "https://www.iso.org"
        },
        {
          "@value": "Logistiikan maailma -termisanasto:2025",
          "@language": "fi",
          "@id": "https://www.logistiikanmaailma.fi/aineistot/sanastot/logistiikan-maailma-termisanasto/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/mes"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-30T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/mto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tilausohjautuva tuotanto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "kundorderstyrd produktion",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "make-to-order",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "MTO",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "MTO",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "MTO",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tuotantomuoto, jossa tuotteet valmistetaan asiakaskohtaisten tilausten perusteella ennalta määriteltyjen tuotesuunnitelmien mukaisesti.",
          "@language": "fi"
        },
        {
          "@value": "Produktionsform där produkter tillverkas utifrån kundspecifika beställningar enligt fördefinierade produktplaner.",
          "@language": "sv"
        },
        {
          "@value": "Production strategy in which products are manufactured based on customer-specific orders according to predefined product designs.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "MTO-tuotteet ovat usein pitkälti kustomoituja ja niiden tuotantoajat ovat MTS-tuotteita pidempiä, koska tuotanto aloitetaan tilauksesta.\nTuotantomuotoa käytetään, kun tuotevalikoima on laaja ja yksittäisten tuotteiden kysyntä on vähäistä.\nVähäisen kysynnän vuoksi tuotteet ovat tyypillisesti kalliimpia kuin MTS-tuotannossa, mutta tarjoavat enemmän joustavuutta ja kustomointimahdollisuuksia.\nRakentamisessa MTO-tuotteet voivat olla lähellä standardoituja tuotteita, mutta sisältää asiakaskohtaisia muokkauksia, kuten värivaihtoehtoja, jotka toteutetaan vasta tilauksen jälkeen.\n",
          "@language": "fi"
        },
        {
          "@value": "MTO-produkter är ofta i hög grad kundanpassade och har längre ledtider än MTS-produkter eftersom produktionen startar först efter beställning.\nProduktionsformen används när produktutbudet är brett och efterfrågan per produkt är låg.\nProdukterna är typiskt dyrare än i MTS-produktion men möjliggör större flexibilitet och kundanpassning.\nInom byggsektorn kan MTO-produkter likna standardprodukter men inkludera kundspecifika variationer, såsom färgval som produceras efter beställning.\n",
          "@language": "sv"
        },
        {
          "@value": "MTO products are often highly customized and have longer lead times than MTS products because production starts upon order.\nThe strategy is used when the product range is wide and demand per item is low.\nProducts are typically more expensive than in MTS production but offer greater flexibility and customization possibilities.\nIn construction, MTO products may resemble standard products but include customer-specific modifications such as color variants produced after ordering.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Alaluusua 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        },
        {
          "@value": "Peltokorpi 2020",
          "@language": "fi",
          "@id": "https://www.aalto.fi/sites/default/files/2020-11/Loppuraportti_Tuotetiedon%20hallinta%20ja%20hyo%CC%88dynta%CC%88minen_2.11.2020_0.pdf"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tuotantomuoto"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/mts",
        "https://teemualaluusua.github.io/sanasto1/#/concept/eto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/asiakastilauksen-kytkeytymiskohta",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ato",
        "https://teemualaluusua.github.io/sanasto1/#/concept/dto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/vakiotuote"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-19T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tahtivaunu-työpaketti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tahtivaunu (työpaketti)",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "taktvagn (arbetspaket)",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "takt wagon (work package)",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "”Arvoa tuottava prosessi”. Kuvaa sitä tehtäväkokonaisuutta, jonka työryhmä suorittaa yhdellä tahtialueella yhden tahtiajan aikana.",
          "@language": "fi"
        },
        {
          "@value": "\"En värdeskapande process.\" Beskriver den uppgiftshelhet som en arbetsgrupp utför inom ett taktområde under en taktid.",
          "@language": "sv"
        },
        {
          "@value": "\"A value-adding process.\" Describes the set of tasks that a work crew performs within one takt area during one takt time.",
          "@language": "en"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tahtialue",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tahtiaika",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tahtituotanto"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/url",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "yhtenäinen resurssin sijainti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "enhetlig resurslokaliserare",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "uniform resource locator",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "URL",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "URL",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "URL",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "URI-merkkijono, joka yksilöi resurssin ja samalla kertoo, miten\nja mistä verkko-osoitteesta resurssi on saatavissa (esim. sen\nverkkoprotokolla ja sijainti).\n",
          "@language": "fi"
        },
        {
          "@value": "En URI-sträng som identifierar en resurs och samtidigt anger hur\noch varifrån resursen kan hämtas (t.ex. protokoll och plats).\n",
          "@language": "sv"
        },
        {
          "@value": "A URI string that identifies a resource while also specifying the\nmeans of locating it, such as its network protocol and address.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "URL on yksi URI:n muoto; kaikki URL:t ovat URI:ita, mutta kaikki\nURI:t eivät ole URL:eja (esim. pelkkä nimeävä URN ei kerro\nresurssin sijaintia).\n",
          "@language": "fi"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RFC 3986 - Uniform Resource Identifier (URI)",
          "@id": "https://www.rfc-editor.org/rfc/rfc3986"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/uri"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/laajat-kielimallit-llm",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "laajat kielimallit (LLM)",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "stora språkmodeller",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "large language models, LLM",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Laajat kielimallit on tekoälyyn perustuva järjestelmä, jota käytetään esimerkiksi ennustamaan todennäköisyyttä lauseen seuraavasta sanasta, kääntämisessä ja vastausten tuottamisessa annetun syötteen perusteella. Laajat kielimallit perustuvat koneoppimiseen, ja erityisesti syväoppimiseen. Tämä tarkoittaa sitä, että kielimalli hyödyntää ja kehittää itsenäisesti eräänlaista ihmisen aivojen toimintaa jäljittelevää järjestelmää, joka oppii käsillä olevia konteksteja, merkityksiä ja asiayhteyksiä. Tällaiset kielimallit vaativat myös oppiakseen ja kehittyäkseen suuria tietokantoja, joita kutsutaan myös koulutusdataksi. Kielimallin hyödyntämä koulutusdata voi olla esimerkiksi internetistä kerättyä tietoa. Mitä suuremman ja tarkemman tietokannan kielimalli saa käyttöönsä ja mitä kauemmin sen annetaan oppia ja tehdä virheitä, on yleensä sen kyky ennustaa ja tuottaa tekstiä parempi. Kielimallin tehtävä on siis generoida ihmismäistä sujuvaa tekstiä sille annetun syötteen (prompt) perusteella. Yleisin syötteen antotapa tekoälysovellukselle on tekstikenttään kirjoitettu teksti. Maailmalla tunnettuja kielimalleja ovat mm. OpenAI:n ChatGPT ja Googlen Gemini.",
          "@language": "fi"
        },
        {
          "@value": "Stora språkmodeller är AI-baserade system som används till exempel för att förutsäga sannolikheten för nästa ord i en mening, för översättning och för att generera svar utifrån given indata. Stora språkmodeller bygger på maskininlärning, i synnerhet djupinlärning. Detta innebär att språkmodellen självständigt utnyttjar och utvecklar ett slags system som efterliknar den mänskliga hjärnans funktion och som lär sig aktuella sammanhang och betydelser. Sådana språkmodeller kräver också stora databaser, så kallad träningsdata, för att lära sig och utvecklas. Träningsdatan som språkmodellen utnyttjar kan till exempel vara information som samlats in från internet. Ju större och mer exakt databas språkmodellen får tillgång till och ju längre den får lära sig och göra misstag, desto bättre blir i regel dess förmåga att förutsäga och generera text. Språkmodellens uppgift är alltså att generera mänskligt flytande text utifrån den indata (prompt) som ges. Det vanligaste sättet att ge indata till en AI-applikation är text skriven i ett textfält. Kända språkmodeller i världen är bland annat OpenAI:s ChatGPT och Googles Gemini.",
          "@language": "sv"
        },
        {
          "@value": "Large language models are AI-based systems used, for example, to predict the probability of the next word in a sentence, for translation, and for generating responses based on a given input. Large language models are based on machine learning, and in particular deep learning. This means that the language model independently utilizes and develops a system that mimics the workings of the human brain, learning the contexts and meanings at hand. Such language models also require large databases, known as training data, in order to learn and develop. The training data used by a language model may, for example, be information collected from the internet. The larger and more accurate the database the language model has access to, and the longer it is allowed to learn and make mistakes, the better its ability to predict and generate text generally becomes. The task of the language model is thus to generate human-like, fluent text based on the input (prompt) given to it. The most common way of providing input to an AI application is text typed into a text field. Well-known language models worldwide include OpenAI's ChatGPT and Google's Gemini.",
          "@language": "en"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/koneoppiminen"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/alfanumeerinen-koodi",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "alfanumeerinen koodi",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "alfanumerisk kod",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "alphanumeric code",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "aakkosnumeerinen koodi",
          "@language": "fi",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Alfanumeerinen koodi (myös aakkosnumeerinen koodi) tarkoittaa aakkosista (a-z) ja numeroista (0-9) koostuvaa koodia, jossa hyödynnetään myös välimerkkejä.",
          "@language": "fi"
        },
        {
          "@value": "Alfanumerisk kod (även alfanumerisk kod) avser en kod som består av bokstäver (a-z) och siffror (0-9), där även skiljetecken används.",
          "@language": "sv"
        },
        {
          "@value": "An alphanumeric code refers to a code consisting of letters (a-z) and digits (0-9), which also makes use of punctuation marks.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN 1556:1998",
          "@language": "fi",
          "@id": "https://sales.sfs.fi/fi/index/tuotteet/SFS/CEN/ID2/1/246564.html.stx"
        },
        {
          "@value": "ISO/IEC 19762:2025",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/84412.html"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/alfanumeerinen"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/semanttinen-web",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "semanttinen web",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "semantisk webb",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "semantic web",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "W3C:n visio ja joukko standardeja (mm. RDF, RDFS, OWL, SPARQL,\nSKOS), joiden avulla webin tieto kuvataan koneellisesti\ntulkittavassa, linkitetyssä muodossa siten, että ohjelmistot\nvoivat päätellä ja yhdistellä tietoa eri lähteistä.\n",
          "@language": "fi"
        },
        {
          "@value": "W3C:s vision och en uppsättning standarder (bl.a. RDF, RDFS, OWL,\nSPARQL, SKOS) för att beskriva webbens data i en maskinläsbar,\nlänkad form så att program kan sluta sig till och kombinera\ninformation från olika källor.\n",
          "@language": "sv"
        },
        {
          "@value": "A W3C vision and set of standards (including RDF, RDFS, OWL,\nSPARQL and SKOS) for describing web data in a machine-readable,\nlinked form so that software can reason over and combine\ninformation from different sources.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Semanttinen web -teknologioita hyödynnetään myös rakennusalan\ntiedonhallinnassa esimerkiksi linkitetyn datan ja ontologioiden\navulla, kun tietomallien sisältöä yhdistetään eri järjestelmien\nja lähteiden kesken.\n",
          "@language": "fi"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Semantic Web - W3C",
          "@id": "https://www.w3.org/standards/semanticweb/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rdf",
        "https://teemualaluusua.github.io/sanasto1/#/concept/owl",
        "https://teemualaluusua.github.io/sanasto1/#/concept/sparql",
        "https://teemualaluusua.github.io/sanasto1/#/concept/skos",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ontologia",
        "https://teemualaluusua.github.io/sanasto1/#/concept/linkitetty-data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/rdf-kolmikko"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiomalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "informaatiomalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "informationsmodell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "information model",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "tiettyä kohdetta kuvaava malli, jossa joukko tulkittavissa olevaa dataa on esitetty jäsennetyssä muodossa",
          "@language": "fi"
        },
        {
          "@value": "modell som beskriver ett visst objekt där en mängd tolkbar data presenteras i strukturerad form",
          "@language": "sv"
        },
        {
          "@value": "model describing a particular object in which a set of interpretable data is presented in a structured form",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Informaatiomalli on ihmisen tulkittavissa ja tietomallien mukaiselta osaltaan koneluettavassa muodossa.",
          "@language": "fi"
        },
        {
          "@value": "Informationsmodellen är tolkbar för människor och i den del som följer datamodeller även maskinläsbar.",
          "@language": "sv"
        },
        {
          "@value": "An information model is interpretable by humans and, where it follows data models, also machine-readable.",
          "@language": "en"
        },
        {
          "@value": "Informaatiomalli voi sisältää esimerkiksi geometrisia malleja,\nluetteloita, tietokantoja, kirjallisia dokumentteja, kuvia,\nvideoleikkeitä ja äänitteitä. Geometrisia malleja voidaan\nesittää 2- tai 3-ulotteisina ja niihin sisältyy usein sijaintitietoa.\n",
          "@language": "fi"
        },
        {
          "@value": "En informationsmodell kan innehålla till exempel geometriska modeller,\nlistor, databaser, skriftliga dokument, bilder, videoklipp och\nljudinspelningar. Geometriska modeller kan presenteras i två eller\ntre dimensioner och innehåller ofta positionsinformation.\n",
          "@language": "sv"
        },
        {
          "@value": "An information model may include, for example, geometric models,\nlists, databases, textual documents, images, video clips and\naudio recordings. Geometric models may be represented in two or\nthree dimensions and often include spatial information.\n",
          "@language": "en"
        },
        {
          "@value": "SFS-EN ISO 19650 -standardissa informaatiomalli-käsitteen\nmääritelmässä viitataan informaatiokoosteeseen, koska määritelmä\non laadittu mallin muodostamisen näkökulmasta. Informaatiokooste\non nimetty pysyvä joukko informaatiota, joka on noudettavissa\ntiedoston, järjestelmän tai sovelluksen tallennushierarkiasta.\n",
          "@language": "fi"
        },
        {
          "@value": "I standarden SFS-EN ISO 19650 hänvisar definitionen av\ninformationsmodell till ett informationssammanhang\n(information container), eftersom definitionen är formulerad\nur perspektivet att skapa en modell. Ett informationssammanhang\när en namngiven beständig uppsättning information som kan hämtas\nfrån ett fil-, system- eller applikationsbaserat lagringshierarki.\n",
          "@language": "sv"
        },
        {
          "@value": "In the SFS-EN ISO 19650 standard the definition of an\ninformation model refers to an information container,\nbecause the definition is formulated from the perspective\nof creating the model. An information container is a named\npersistent set of information retrievable from a file,\nsystem or application storage hierarchy.\n",
          "@language": "en"
        },
        {
          "@value": "Käsitejärjestelmäkaavio:\nhttps://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg\n",
          "@language": "fi"
        },
        {
          "@value": "Begreppssystemdiagram:\nhttps://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg\n",
          "@language": "sv"
        },
        {
          "@value": "Concept system diagram:\nhttps://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 19650 – RY-mallit sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rymallit/c15"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/pim",
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-informaatiomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatio",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomallinnus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiomallinnus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiovaatimus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/mallinnus"
      ],
      "dcterms:created": {
        "@value": "2025-12-23T14:08",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/asiakastilauksen-kytkeytymiskohta",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "asiakastilauksen kytkeytymiskohta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "kundorderpunkt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "customer order decoupling point",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "tilauskytkentäpiste",
          "@language": "fi",
          "termType": "Synonyymi"
        },
        {
          "@value": "tilauksen kytkeytymispiste",
          "@language": "fi",
          "termType": "Synonyymi"
        },
        {
          "@value": "kundorderkopplingspunkt",
          "@language": "sv",
          "termType": "Synonyymi"
        },
        {
          "@value": "order penetration point",
          "@language": "en",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Se toimitusketjun kohta, jossa tuote tai palvelu liitetään asiakkaan tekemään\ntilaukseen ja jossa toiminta muuttuu ennusteohjautuvasta tilausohjautuvaksi.\n",
          "@language": "fi"
        },
        {
          "@value": "Den punkt i leveranskedjan där en produkt eller tjänst kopplas till en kundorder\noch där styrningen övergår från prognosbaserad till orderstyrd.\n",
          "@language": "sv"
        },
        {
          "@value": "The point in the supply chain where a product or service is linked to a specific\ncustomer order and operations shift from forecast-driven to order-driven.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Logistiikan maailma -termisanasto:2025",
          "@language": "fi",
          "@id": "https://www.logistiikanmaailma.fi/aineistot/sanastot/logistiikan-maailma-termisanasto/"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/toimitusketju"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/arvoketju",
        "https://teemualaluusua.github.io/sanasto1/#/concept/mto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ato"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-27T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/data",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "data",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Datalla tarkoitetaan informaation uudelleen tulkittavissa olevaa esitystapaa virallistetulla tavalla, joka soveltuu viestintään, tulkintaan tai käsittelyyn.",
          "@language": "fi"
        },
        {
          "@value": "Data avser en formaliserad representation av information som kan tolkas på nytt och som lämpar sig för kommunikation, tolkning eller behandling.",
          "@language": "sv"
        },
        {
          "@value": "Data refers to a formalized representation of information that can be reinterpreted and is suitable for communication, interpretation or processing.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2017",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatio"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/avoin-data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/big-data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatio",
        "https://teemualaluusua.github.io/sanasto1/#/concept/koneluettavuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/linkitetty-data"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/metatieto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietue",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tiedonhallinta",
        "https://teemualaluusua.github.io/sanasto1/#/concept/bitti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/bittitavu",
        "https://teemualaluusua.github.io/sanasto1/#/concept/digitalisaatio",
        "https://teemualaluusua.github.io/sanasto1/#/concept/digitointi",
        "https://teemualaluusua.github.io/sanasto1/#/concept/it",
        "https://teemualaluusua.github.io/sanasto1/#/concept/koneoppiminen"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohde",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "rakennuskohde",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "byggnadsobjekt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "construction",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "fyysinen kokonaisuus, jota parhaillaan rakennetaan tai joka on rakennettu",
          "@language": "fi"
        },
        {
          "@value": "fysisk helhet som håller på att byggas eller som har byggts",
          "@language": "sv"
        },
        {
          "@value": "physical entity that is being built or has been built",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Infrarakentamisessa rakennuskohteita voidaan kutsua infrakohteiksi. Niitä ovat esimerkiksi liikenneväylät, padot ja satamat.",
          "@language": "fi"
        },
        {
          "@value": "Talonrakennuksessa rakennuskohteita ovat esimerkiksi rakennukset, rakennelmat ja niiden ulkoalueet.",
          "@language": "fi"
        },
        {
          "@value": "Käsitejärjestelmäkaavio: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "fi"
        },
        {
          "@value": "Inom infrastrukturbyggande kan byggnadsobjekt kallas infraobjekt. Sådana är till exempel trafikleder, dammar och hamnar.",
          "@language": "sv"
        },
        {
          "@value": "Inom husbyggande är byggnadsobjekt till exempel byggnader, konstruktioner och deras utomhusområden.",
          "@language": "sv"
        },
        {
          "@value": "Begreppssystemschema: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "sv"
        },
        {
          "@value": "In infrastructure construction, construction entities may be called infrastructure entities. Examples include traffic routes, dams and harbors.",
          "@language": "en"
        },
        {
          "@value": "In building construction, construction entities include, for example, buildings, structures and their outdoor areas.",
          "@language": "en"
        },
        {
          "@value": "Concept system diagram: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastokeskus, RY-mallit -sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rymallit/c28"
        },
        {
          "@value": "Sanastokeskus, RAKYMP-sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rakymp/c5"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/digitaalinen-kaksonen",
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-informaatiomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/loppukatselmusmalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/suunnitelmamalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/toteumamalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/omaisuuskohteen-informaatiomalli"
      ],
      "dcterms:created": {
        "@value": "2025-12-23T14:08",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/komponentti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "komponentti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "komponent",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "component",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Yksi kokonaisuuden osa.",
          "@language": "fi"
        },
        {
          "@value": "En del av en helhet.",
          "@language": "sv"
        },
        {
          "@value": "One of the parts of a system, process, or machine.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Rakennuskohteen komponentit ovat joko rakennusosia tai tuoteosia.\nRakennusosat valmistetaan pääosin työmaalla, kun taas tuoteosat ovat valmiita ostettavia tuotteita, jotka asennetaan.\n",
          "@language": "fi"
        },
        {
          "@value": "Komponenter i en byggnad utgörs av byggdelar eller produktdelar.\nByggdelar tillverkas huvudsakligen på plats, medan produktdelar är färdiga produkter som installeras.\n",
          "@language": "sv"
        },
        {
          "@value": "In construction, components can be building elements or product elements.\nBuilding elements are mainly assembled on site, while product elements are pre-manufactured items that are installed.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Cambridge Dictionary",
          "@language": "en",
          "@id": "https://dictionary.cambridge.org/dictionary/english/component"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/bom",
        "https://teemualaluusua.github.io/sanasto1/#/concept/nimikkeistö-tai-luokitus"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-19T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tiedon-louhinta",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tiedon louhinta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "datautvinning",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data mining",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "tietokoneperusteiset tiedonhakutoimenpiteet, joiden avulla tunnistetaan malleja analysoimalla kvantitatiivista dataa eri näkökulmista ja ulottuvuuksista, kategorisoidaan sitä ja tehdään yhteenvetoja potentiaalisista suhteista ja vaikutuksista",
          "@language": "fi"
        },
        {
          "@value": "datorbaserad process för informationssökning och analys där mönster identifieras genom att analysera kvantitativa data från olika perspektiv och dimensioner, kategorisera dem och sammanfatta potentiella samband och effekter",
          "@language": "sv"
        },
        {
          "@value": "computational search and retrieval process that identifies patterns by analysing quantitative data from different perspectives and dimensions, categorizing it, and summarizing potential relationships and impacts",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Tiedon louhintaa käytetään esimerkiksi suurten\ntietoaineistojen analysoinnissa, ennusteiden\ntekemisessä sekä piilevien riippuvuuksien\ntunnistamisessa datasta.\n",
          "@language": "fi"
        },
        {
          "@value": "Datautvinning används till exempel för analys\nav stora datamängder, för att göra prognoser\noch för att identifiera dolda samband i data.\n",
          "@language": "sv"
        },
        {
          "@value": "Data mining is commonly used to analyse large\ndatasets, discover hidden patterns and support\npredictive analytics.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/data-analytiikka"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/big-data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/koneoppiminen"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
