    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/digitalisaatio",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "digitalisaatio",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "digital transformation",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "digital transformation",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "toimintakulttuurin systeeminen muutos, jossa digitaalisia teknologioita hyödynnetään toiminnan tehostamiseksi ja kehittämiseksi",
          "@language": "fi"
        },
        {
          "@value": "systemisk förändring av verksamhetskultur där digital teknik används för att effektivisera och utveckla verksamheten",
          "@language": "sv"
        },
        {
          "@value": "systemic change of operational culture in which digital technologies are used to improve and transform activities",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Digitalisaatio perustuu usein datan hyödyntämiseen ja analysointiin.",
          "@language": "fi"
        },
        {
          "@value": "Digital transformation baseras ofta på användning och analys av data.",
          "@language": "sv"
        },
        {
          "@value": "Digital transformation is often based on the use and analysis of data.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC TS 30105-9:2023",
          "@language": "en",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tiedonhallinta",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietojärjestelmä",
        "https://teemualaluusua.github.io/sanasto1/#/concept/digitointi"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/edi",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "electronic data interchange",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "electronic data interchange",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "electronic data interchange",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "EDI",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "EDI",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "EDI",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "standardoitu tekniikka, jota käytetään organisaatioiden välisten tietojärjestelmien kommunikointiin",
          "@language": "fi"
        },
        {
          "@value": "standardiserad teknik som används för kommunikation mellan informationssystem i olika organisationer",
          "@language": "sv"
        },
        {
          "@value": "standardized technique used for communication between information systems of different organizations",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "EDI yhdistetään yleensä EDIFACT-sanomaformaattiin. Suurin osa esimerkiksi\nkaupan, tukkukaupan, teollisuuden ja kuljetusalan sanomista on EDIFACT-standardin mukaisia sanomia.\n",
          "@language": "fi"
        },
        {
          "@value": "EDI kopplas vanligtvis till EDIFACT-meddelandeformatet. En stor del av\nmeddelandena inom handel, grossisthandel, industri och transport följer EDIFACT-standarden.\n",
          "@language": "sv"
        },
        {
          "@value": "EDI is commonly associated with the EDIFACT message format. A large share of\nmessages in trade, wholesale, industry and transport sectors follow the EDIFACT standard.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastot.suomi.fi",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yritysdigi/concept-2003"
        },
        {
          "@value": "ISO/IEC 19762-1:2025",
          "@language": "en",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/finvoice",
        "https://teemualaluusua.github.io/sanasto1/#/concept/peppol-verkosto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ubl",
        "https://teemualaluusua.github.io/sanasto1/#/concept/hankintasanoma"
      ],
      "dcterms:created": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/konenäkö",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "konenäkö",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "datorseende",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "computer vision",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Konenäkö tarkoittaa toiminnallisen yksikön kykyä hankkia, käsitellä ja tulkita dataa kuva- tai videomuodossa olevasta lähteestä. Konenäkö sisältää sensoreiden käyttöä visuaalista tilannetta esittävän digitaalisen kuvan luomiseen. Konenäkö liittyy läheisesti kuvantunnistukseen, kuten digitaalisten kuvien käsittelyyn. Kuvamuodossa oleva data on yleensä peräisin digitaalisesta kamerasta, digitaalisesti skannatusta fyysisestä kuvasta tai jostain muusta kuvansyöttölaitteesta. Digitaaliset kuvat ovat olemassa numeromatriisina, joka edustaa kuvassa olevia harmaa-asteikon sävyjä tai värejä tai joissain tapauksissa vektorien kokoelmaa. Digitaaliset kuvat voivat sisältää metatietoa, joka kuvailee kuvaan liittyviä ominaispiirteitä ja attribuutteja. Digitaaliset kuvat voidaan pakata tallennustilan säästämiseksi ja niiden lähetysnopeuden parantamiseksi digitaalisissa verkoissa.",
          "@language": "fi"
        },
        {
          "@value": "Datorseende avser en funktionell enhets förmåga att skaffa, bearbeta och tolka data från en bild- eller videobaserad källa. Datorseende omfattar användning av sensorer för att skapa en digital bild som återger en visuell situation. Datorseende är nära besläktat med bildigenkänning, såsom behandling av digitala bilder. Data i bildform härrör vanligen från en digitalkamera, en digitalt skannad fysisk bild eller någon annan bildinmatningsenhet. Digitala bilder existerar som en talmatris som representerar gråskalenyanser eller färger i bilden, eller i vissa fall som en samling vektorer. Digitala bilder kan innehålla metadata som beskriver egenskaper och attribut som hör till bilden. Digitala bilder kan komprimeras för att spara lagringsutrymme och förbättra överföringshastigheten i digitala nätverk.",
          "@language": "sv"
        },
        {
          "@value": "Computer vision refers to a functional unit's ability to acquire, process and interpret data from an image- or video-based source. Computer vision includes the use of sensors to create a digital image representing a visual scene. Computer vision is closely related to image recognition, such as the processing of digital images. Image-form data usually originates from a digital camera, a digitally scanned physical image, or some other image input device. Digital images exist as a numerical matrix representing the grayscale shades or colors in the image, or in some cases as a collection of vectors. Digital images may contain metadata describing features and attributes related to the image. Digital images can be compressed to save storage space and to improve their transmission speed over digital networks.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 22989:2023",
          "@language": "fi",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/metatieto"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
