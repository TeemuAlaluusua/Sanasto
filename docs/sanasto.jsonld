    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tietue",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tietue",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "post",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "record",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "dokumentin osa tai dokumentti, joka sisältää rakenteellisen ja sisäisesti järjestetyn joukon itsenäistä mutta toisiinsa liittyvää dataa, joka koskee yhtä henkilöä tai muuta oliota ja joka on valittu ja esitetty tiettyä tarkoitusta varten",
          "@language": "fi"
        },
        {
          "@value": "del av ett dokument eller dokument som innehåller en strukturerad och internt organiserad uppsättning självständiga men relaterade data om en person eller annat objekt, valda och presenterade för ett specifikt syfte",
          "@language": "sv"
        },
        {
          "@value": "part of a document or document containing a structured and internally organized set of self-contained but related data on one person or other object, selected and presented for a predefined specific purpose",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Tietue koostuu yleensä useista kentistä,\njotka kuvaavat tietyn kohteen ominaisuuksia.\n",
          "@language": "fi"
        },
        {
          "@value": "En post består vanligtvis av flera fält\nsom beskriver egenskaper hos ett visst objekt.\n",
          "@language": "sv"
        },
        {
          "@value": "A record typically consists of several\nfields describing attributes of a given object.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietokanta"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietorakenne",
        "https://teemualaluusua.github.io/sanasto1/#/concept/data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/metatieto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ifcql"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/vakiointi",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "vakiointi",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "enhetliggörande",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "standardization (of practices)",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Vakioinnilla tarkoitetaan tiedonhallinnan ja toimintatapojen yhdenmukaistamista ja vakiinnuttamista.",
          "@language": "fi"
        },
        {
          "@value": "Med enhetliggörande avses harmonisering och etablering av informationshantering och tillvägagångssätt.",
          "@language": "sv"
        },
        {
          "@value": "Standardization (of practices) refers to the harmonization and establishment of information management and operating methods.",
          "@language": "en"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/standardointi"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/skos",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "simple knowledge organization system",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "simple knowledge organization system",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "simple knowledge organization system",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "SKOS",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "SKOS",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "SKOS",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Yleinen tietomalli, jonka avulla jaetaan ja linkitetään\ntietämysalkioita internetissä.\n",
          "@language": "fi"
        },
        {
          "@value": "En gemensam datamodell för att dela och länka\nkunskapsobjekt på internet.\n",
          "@language": "sv"
        },
        {
          "@value": "Common data model for sharing and linking\nknowledge items via the internet.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "SKOS on W3C:n suositus sanastojen, tesaurusten ja\nluokitusjärjestelmien esittämiseen RDF-muodossa.\n",
          "@language": "fi"
        },
        {
          "@value": "SKOS är en W3C-rekommendation för att representera\ntesaurer, klassifikationssystem och andra vokabulärer i RDF.\n",
          "@language": "sv"
        },
        {
          "@value": "SKOS is a W3C recommendation used to represent\nthesauri, classification schemes and other vocabularies in RDF.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "SKOS Simple Knowledge Organization System Reference",
          "@id": "https://www.w3.org/TR/skos-reference/"
        },
        {
          "@value": "ISO 5127:2022"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rdf",
        "https://teemualaluusua.github.io/sanasto1/#/concept/owl",
        "https://teemualaluusua.github.io/sanasto1/#/concept/semanttinen-web"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/oikeudellinen-yhteentoimivuus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "oikeudellinen yhteentoimivuus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "rättslig interoperabilitet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "legal interoperability",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "yhteentoimivuus, joka mahdollistaa tiedonsiirrot eri lainsäädännöllisten alueiden välillä ilman, että asiaankuuluvaa lainsäädäntöä rikotaan",
          "@language": "fi"
        },
        {
          "@value": "interoperabilitet som gör det möjligt att överföra information mellan områden med olika lagstiftning utan att relevanta lagar bryts",
          "@language": "sv"
        },
        {
          "@value": "form of interoperability that enables data transfers between different legislative regions without violating any pertinent legislation",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Oikeudellinen yhteentoimivuus liittyy erityisesti tietojärjestelmissä käsiteltävien tietojen luonteeseen ja tapoihin, joilla tietoja kerätään, järjestetään ja siirretään.",
          "@language": "fi"
        },
        {
          "@value": "Rättslig interoperabilitet anknyter speciellt till information i informationssystem samt till informationens art och hur man samlar in, ordnar och överför informationen.",
          "@language": "sv"
        },
        {
          "@value": "Legal interoperability is connected especially to the nature of the data that is contained in the information systems and how this data is collected, arranged and transferred.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-71"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/yhteentoimivuus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tekninen-yhteentoimivuus",
