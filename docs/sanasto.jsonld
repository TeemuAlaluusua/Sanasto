    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/ubl",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "Universal Business Language",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Universal Business Language",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Universal Business Language",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "UBL",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "UBL",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "UBL",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "XML-pohjainen standardi liiketoiminta-asiakirjojen tietojen esittämiseen ja vaihtoon",
          "@language": "fi"
        },
        {
          "@value": "XML-baserad standard för att representera och utbyta affärsdokument",
          "@language": "sv"
        },
        {
          "@value": "XML-based standard for representing and exchanging business documents",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "UBL määrittelee yhteisen tietorakenteen ja XML-skeemat asiakirjoille,\nkuten tilauksille, laskuille ja toimitusilmoituksille.\n",
          "@language": "fi"
        },
        {
          "@value": "UBL perustuu uudelleenkäytettäviin tietokomponentteihin (Business Information Entities, BIE)\nja mahdollistaa toimialakohtaiset laajennukset.\n",
          "@language": "fi"
        },
        {
          "@value": "UBL:n tavoitteena on vähentää eri toimialojen välisten tiedonsiirtomuotojen\nmoninaisuutta ja helpottaa järjestelmien välistä yhteentoimivuutta.\n",
          "@language": "fi"
        },
        {
          "@value": "UBL definierar gemensamma datastrukturer och XML-scheman för dokument som\nbeställningar, fakturor och leveransaviseringar.\n",
          "@language": "sv"
        },
        {
          "@value": "UBL defines common data structures and XML schemas for documents such as\norders, invoices and despatch advice.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 19845:2015 Information technology — Universal business language version 2.1",
          "@language": "en",
          "@id": "https://www.iso.org/obp/ui/en/#iso:std:66370:en"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/vaihtoformaatti"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/edi",
        "https://teemualaluusua.github.io/sanasto1/#/concept/xml",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/finvoice",
        "https://teemualaluusua.github.io/sanasto1/#/concept/peppol-verkosto"
      ],
      "dcterms:created": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
