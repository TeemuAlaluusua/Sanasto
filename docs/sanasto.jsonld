    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/ebom",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "suunnittelun tuoteosaluettelo",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "konstruktionsmateriallista",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "engineering bill of material",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "eBOM",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "eBOM",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "eBOM",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Luettelo osanumeroista ja kokoonpanoista, jotka muodostavat\nsuunnittelun mukaisen tuotteen kokoonpanorakenteen ja\nsisältävät esimerkiksi raaka-aineen mitat ja\nmateriaalimääritykset.\n",
          "@language": "fi"
        },
        {
          "@value": "Lista över artikelnummer och sammansättningar som utgör\nden konstruktionsmässiga produktkonfigurationen och som\ninnehåller uppgifter om råmaterialets dimensioner och\nmaterialspecifikationer.\n",
          "@language": "sv"
        },
        {
          "@value": "List of part numbers and assemblies that make up the\ndesign engineering configuration that contains the raw\nstock size and the material specification.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "English definition adapted from ISO 10303-240:2005.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/TR 3151-1:2023(E)",
          "@language": "en"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/bom"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/mbom"
      ],
      "dcterms:created": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tietopankki",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tietopankki",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "databank",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data repository",
          "@language": "en",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data bank",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "joukko tiedostoja tai tietokantoja, joilla on yhteinen varastointijärjestelmä, käsittelyjärjestelmä ja hakujärjestelmä",
          "@language": "fi"
        },
        {
          "@value": "samling filer eller databaser som har ett gemensamt lagringssystem, behandlingssystem och söksystem",
          "@language": "sv"
        },
        {
          "@value": "set of files or databases combined with a storage system, a processing system and a retrieval system",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Tietopankki tarkoittaa järjestettyä kokonaisuutta, jossa tietoa\ntallennetaan, ylläpidetään ja haetaan yhtenäisen järjestelmän avulla.\nTermiä käytetään usein yleisnimityksenä järjestelmälle, joka kokoaa\nuseita tietokantoja tai tiedostoja yhteen hallittuun tietovarastoon.\n",
          "@language": "fi"
        },
        {
          "@value": "En databank är en organiserad helhet där information lagras, underhålls\noch hämtas med hjälp av ett enhetligt system. Termen används ofta som\nen allmän beteckning för ett system som samlar flera databaser eller\nfiler i ett gemensamt hanterat informationslager.\n",
          "@language": "sv"
        },
        {
          "@value": "A data repository or data bank refers to an organised collection in\nwhich information is stored, maintained and retrieved through a\nunified system. The term is often used as a general designation for a\nsystem that brings together several databases or files into a managed\ninformation storage environment.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022 Information and documentation — Foundation and vocabulary",
          "@language": "en",
          "@id": "https://www.iso.org/standard/59743.html"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietokanta"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/lod",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "LOD",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "LOD",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Level of Development",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Suunnittelun kehitystasomäärittely LOD on tietomallintamisen teoreettinen vertailumenetelmä, jonka tarkoituksena on parantaa rakennustietomallien (BIM) käyttäjien välistä viestintää mallien elementtien ominaisuuksista niiden kehitysvaiheen mukaan. LOD-kehitystasot perustuvat suunnittelun eri loppukäyttötarkoitusten tietovaatimuksiin: lupaprosessi (LOD 100-300), hankinta (LOD 300-350), esivalmistus (LOD 350-400), asennus ja elinkaaren aikainen hallinta (LOD 400). LOD kehitystasomäärittely siis ilmaisee projektitietojen tarkkuutta tietomallissa.",
          "@language": "fi"
        },
        {
          "@value": "LOD (utvecklingsgradsspecifikation) är en teoretisk jämförelsemetod inom modellering som syftar till att förbättra kommunikationen mellan användare av byggnadsinformationsmodeller (BIM) om modellelementens egenskaper enligt deras utvecklingsskede. LOD-utvecklingsgraderna baseras på informationskraven för olika slutanvändningsändamål inom projekteringen: tillståndsprocessen (LOD 100-300), upphandling (LOD 300-350), prefabricering (LOD 350-400), installation och förvaltning under livscykeln (LOD 400). LOD-utvecklingsgradsspecifikationen anger alltså projektinformationens exakthet i informationsmodellen.",
          "@language": "sv"
        },
        {
          "@value": "LOD (Level of Development) is a theoretical benchmarking method in modeling that aims to improve communication between users of building information models (BIM) regarding the properties of model elements according to their stage of development. The LOD levels are based on the information requirements of different end uses within design: the permitting process (LOD 100-300), procurement (LOD 300-350), prefabrication (LOD 350-400), and installation and lifecycle management (LOD 400). The LOD specification thus indicates the level of accuracy of project information within the information model.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "BIMForum: 2023",
          "@language": "fi",
          "@id": "https://bimforum.org/resource/lod-level-of-development-lod-specification/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/loin"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/anturi",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "anturi",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "sensor",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "sensor",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "sensori",
          "@language": "fi",
          "termType": "Synonyymi"
        },
        {
          "@value": "givare",
          "@language": "sv",
          "termType": "Synonyymi"
        },
        {
          "@value": "transducer",
          "@language": "en",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Anturi on laite, joka reagoi fyysiseen ärsykkeeseen kuten lämpöön, valoon,\nääneen, paineeseen, vetovoimaan tai liikkeeseen ja välittää sen arvon eteenpäin.\nAntureita hyödynnetään esimerkiksi erilaisissa IoT-ratkaisuissa.\n",
          "@language": "fi"
        },
        {
          "@value": "En sensor är en anordning som reagerar på en fysisk påverkan såsom värme, ljus,\nljud, tryck, gravitation eller rörelse och vidarebefordrar dess värde.\nSensorer används till exempel i olika IoT-lösningar.\n",
          "@language": "sv"
        },
        {
          "@value": "A sensor is a device that responds to a physical stimulus such as heat, light,\nsound, pressure, gravity or motion and transmits its value onward. Sensors are\nused, for example, in various IoT solutions.\n",
          "@language": "en"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/iot",
        "https://teemualaluusua.github.io/sanasto1/#/concept/lot-järjestelmä",
        "https://teemualaluusua.github.io/sanasto1/#/concept/lot-laite"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-27T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tuotetieto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tuotetieto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "produktdata",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "product data",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tuotetta koskevan tiedon esittäminen muodollisella tavalla, joka soveltuu ihmisten tai tietokoneiden välitettäväksi, tulkittavaksi tai käsiteltäväksi.",
          "@language": "fi"
        },
        {
          "@value": "Formell representation av information om en produkt som kan överföras, tolkas eller behandlas av människor eller datorer.",
          "@language": "sv"
        },
        {
          "@value": "Formal representation of information about a product suitable for communication, interpretation or processing by humans or computers.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Rakennusalalla tuotetieto kattaa laajasti tuotteisiin liittyvän tiedon, kuten esitteet, tekniset ja toiminnalliset ominaisuudet, suunnitelmat, asennus-, käyttö- ja huolto-ohjeet, tuoterakenteet, osaluettelot, testaustulokset, ympäristövaikutukset sekä turvallisuusnäkökohdat.\nTuotteisiin liittyvä tieto voidaan jakaa vakiotietoihin, instanssitietoihin ja prosessitietoihin.\n",
          "@language": "fi"
        },
        {
          "@value": "Inom byggsektorn omfattar produktdata ett brett spektrum av produktrelaterad information, såsom broschyrer, tekniska och funktionella egenskaper, ritningar, installations-, drift- och underhållsanvisningar, produktstrukturer, stycklistor, testresultat, miljöpåverkan samt säkerhetsaspekter.\nProduktinformation kan delas in i standarddata, instansdata och processdata.\n",
          "@language": "sv"
        },
        {
          "@value": "In the construction sector, product data covers a wide range of product-related information such as brochures, technical and functional properties, designs, installation, operation and maintenance instructions, product structures, bills of materials, test results, environmental impacts and safety aspects.\nProduct-related information can be divided into standard data, instance data and process data.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Peltokorpi 2020",
          "@language": "fi",
          "@id": "https://www.aalto.fi/sites/default/files/2020-11/Loppuraportti_Tuotetiedon%20hallinta%20ja%20hyo%CC%88dynta%CC%88minen_2.11.2020_0.pdf"
        },
        {
          "@value": "ISO 10303-1:1994",
          "@language": "fi",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/instanssitieto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/prosessitieto"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-19T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/hankintasanoma",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "hankintasanoma",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "upphandlingsmeddelande",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "procurement message",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Hankintasanoma on kaupankäyntiin liittyvä sanoma, joka on rakenteellisessa ja koneellisesti käsiteltävässä muodossa. Yleisesti rakennusalalla käytetty vakioitu toimitusketjun sähköisen tiedonsiirron menetelmä on ns. verkkolasku, jossa toimittajan järjestelmästä välitetään määrämuotoinen sähköinen sanoma (lasku) suoraan asiakkaan järjestelmään. Rakennustoimialan kannalta tärkeitä sanomamäärittelyjä verkkolaskun lisäksi on olemassa myös toimitusten ohjaukseen esim. tilauksille, tilausvahvistuksille sekä toimituksille (sähköinen rahtikirja).",
          "@language": "fi"
        },
        {
          "@value": "Ett upphandlingsmeddelande är ett meddelande i samband med handel som förekommer i strukturerad och maskinellt hanterbar form. En allmänt använd standardiserad metod för elektronisk dataöverföring i leveranskedjan inom byggbranschen är den så kallade e-fakturan, där ett elektroniskt meddelande i fast format (fakturan) förmedlas direkt från leverantörens system till kundens system. Ur byggbranschens synvinkel finns det förutom e-fakturan även andra viktiga meddelandedefinitioner för styrning av leveranser, till exempel för beställningar, orderbekräftelser och leveranser (elektronisk fraktsedel).",
          "@language": "sv"
        },
        {
          "@value": "A procurement message is a trade-related message in a structured, machine-processable form. A commonly used standardized method for electronic data interchange in the construction industry's supply chain is the so-called e-invoice, in which a fixed-format electronic message (the invoice) is transmitted directly from the supplier's system to the customer's system. From the construction industry's point of view, in addition to the e-invoice there are also other important message definitions for controlling deliveries, for example for orders, order confirmations and deliveries (electronic waybill).",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastot",
          "@language": "fi",
          "@id": "https://sanastot.suomi.fi/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/edi"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/fyysinen-tietomalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "fyysinen tietomalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "fysisk datamodell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "physical data model",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "tietomalli, joka kuvaa tietojen tallentamisen teknisellä tasolla tietokantarakenteena",
          "@language": "fi"
        },
        {
          "@value": "datamodell som beskriver lagringen av data på teknisk nivå som en databasstruktur",
          "@language": "sv"
        },
        {
          "@value": "data model describing the storage of data at a technical level as a database structure",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Fyysinen tietomalli on loogisesta tietomallista\ntarkemmalle tasolle viety kuvaus, jossa otetaan\nkantaa tietokannan käytännön tekniseen toteutukseen\nvalitulla teknologialla.\n",
          "@language": "fi"
        },
        {
          "@value": "En fysisk datamodell är en mer detaljerad\nbeskrivning av en logisk datamodell där den\npraktiska tekniska implementeringen i en databas\nmed vald teknologi specificeras.\n",
          "@language": "sv"
        },
        {
          "@value": "A physical data model is a more detailed\nrepresentation of a logical data model specifying\nthe practical technical implementation in a\ndatabase using a chosen technology.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Suomi.fi-sanasto – RY-mallit",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rymallit/c14"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/looginen-tietomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsitemalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietokanta"
      ],
      "dcterms:created": {
        "@value": "2025-12-23T14:08",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/digitointi",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "digitointi",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "digitalisering",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "digitization",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "prosessi, jossa analoginen aineisto muunnetaan digitaaliseen muotoon",
          "@language": "fi"
        },
        {
          "@value": "process där analogt material omvandlas till digital form",
          "@language": "sv"
        },
        {
          "@value": "process of converting analogue material into digital form",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Digitointi mahdollistaa aineiston tietoteknisen käsittelyn, tallennuksen ja siirron.",
          "@language": "fi"
        },
        {
          "@value": "Digitalisering möjliggör databehandling, lagring och överföring av materialet.",
          "@language": "sv"
        },
        {
          "@value": "Digitization enables computational processing, storage and transfer of the material.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2017",
          "@language": "en",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/digitalisaatio",
        "https://teemualaluusua.github.io/sanasto1/#/concept/data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/koneluettavuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/OCR"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/dto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "asiakasohjautuva tuotekehitys",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "kundstyrd produktutveckling",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "design-to-order",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "DTO",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "DTO",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "DTO",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tuotantotapa, jossa tuotteen suunnittelu, tuotekehitys ja\nvalmistus käynnistyvät asiakaskohtaisen tilauksen perusteella.\n",
          "@language": "fi"
        },
        {
          "@value": "Produktionssätt där produktens konstruktion, produktutveckling\noch tillverkning inleds utifrån en kundspecifik beställning.\n",
          "@language": "sv"
        },
        {
          "@value": "Production strategy in which product design, development\nand manufacturing are initiated based on a specific\ncustomer order.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "DTO-tuotteet ovat asiakasräätälöityjä projektituotteita,\njotka suunnitellaan ja valmistetaan tilauskohtaisesti.\nToisin kuin ETO-tuotteissa, DTO-toimitus voi sisältää\nmerkittävää tuotekehitystä, mikä yleensä pidentää\ntoimitusaikoja.\n",
          "@language": "fi"
        },
        {
          "@value": "DTO-produkter är kundanpassade projektprodukter som\nkonstrueras och tillverkas baserat på en specifik order.\nTill skillnad från ETO-produkter kan DTO-leveranser\ninkludera omfattande produktutveckling, vilket ofta\nleder till längre leveranstider.\n",
          "@language": "sv"
        },
        {
          "@value": "DTO products are typically customized project products\ndesigned and manufactured for a specific order.\nDeliveries may include significant product development,\nwhich often results in longer lead times.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Alaluusua 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        },
        {
          "@value": "Peltokorpi 2020",
          "@language": "fi",
          "@id": "https://www.aalto.fi/sites/default/files/2020-11/Loppuraportti_Tuotetiedon%20hallinta%20ja%20hyo%CC%88dynta%CC%88minen_2.11.2020_0.pdf"
        },
        {
          "@value": "ISO/TR 3151-1:2023",
          "@language": "en",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tuotantomuoto"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/eto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/mto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ato"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/uda",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "käyttäjän määrittelemä attribuutti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "användardefinierat attribut",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "user defined attribute",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "UDA",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "UDA",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "UDA",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "käyttäjän määrittelemällä attribuutilla tarkoitetaan suunnitteluohjelmistoissa mallin objekteille talletettavaa liitännäistietoa (metatieto).",
          "@language": "fi"
        },
        {
          "@value": "Med UDA avses tilläggsinformation (metadata) som lagras för modellobjekt i designprogramvara.",
          "@language": "sv"
        },
        {
          "@value": "A user defined attribute (UDA) refers to additional information (metadata) stored for model objects in design software.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "BEC:2023",
