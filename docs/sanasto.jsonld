    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/semanttinen-yhteentoimivuus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "semanttinen yhteentoimivuus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "semantisk interoperabilitet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "semantic interoperability",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "yhteentoimivuus, joka mahdollistaa tiedon siirtämisen ja käsittelyn tavalla, jossa tiedon merkitys säilyy muuttumattomana ja ymmärrettävänä kaikille osapuolille",
          "@language": "fi"
        },
        {
          "@value": "interoperabilitet som gör det möjligt att överföra och behandla information så att dess innebörd bevaras oförändrad och begriplig för alla parter",
          "@language": "sv"
        },
        {
          "@value": "form of interoperability that enables the transfer and processing of data in a way that retains the meaning of the data so that it remains unchanged and understandable for all parties",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-27"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/yhteentoimivuus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tekninen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/organisatorinen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/oikeudellinen-yhteentoimivuus"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/logistiikka",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "logistiikka",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "logistik",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "logistics",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Logistiikka-käsite tarkoittaa yhteyksien luomista ja parhaan tavan löytämistä päämäärän saavuttamiseksi, jotta aineelliset esineet tai elävät olennot voidaan tuoda riittävässä määrin oikeaan paikkaan oikeaan aikaan. Toimitusketjujen hallinta sekoitetaan usein logistiikka-käsitteeseen, vaikka ne tarkoittavat vain osin samaa asiakokonaisuutta. Toimitusketjun hallinta on toimitusketjun toimijoiden välisiä keskinäisiä riippuvuussuhteita strategisella tasolla kuvaava määritelmä, kun taas logistiikan hallinta keskittyy projektikohteeseen toimitettavien materiaalivirtojen hallintaan operatiivisella tasolla, jossa tarkastellaan yritysten hankintatoimitusprosessia (tulo-, sisä- ja lähtölogistiikkaa).",
          "@language": "fi"
        },
        {
          "@value": "Begreppet logistik avser att skapa kopplingar och hitta det bästa sättet att nå ett mål, så att materiella föremål eller levande varelser kan föras till rätt plats vid rätt tidpunkt i tillräcklig mängd. Hantering av leveranskedjor blandas ofta ihop med begreppet logistik, även om de bara delvis avser samma helhet. Hantering av leveranskedjan är en definition som på strategisk nivå beskriver de ömsesidiga beroendeförhållandena mellan aktörerna i leveranskedjan, medan logistikhantering på operativ nivå fokuserar på hanteringen av materialflöden som levereras till ett projektobjekt, där man granskar företagens anskaffnings- och leveransprocess (ingående, intern och utgående logistik).",
          "@language": "sv"
        },
        {
          "@value": "The concept of logistics refers to creating connections and finding the best way of achieving an objective, so that material goods or living beings can be brought to the right place at the right time in sufficient quantity. Supply chain management is often confused with the concept of logistics, even though the two terms only partly refer to the same subject matter. Supply chain management is a definition describing, at a strategic level, the mutual interdependencies between actors in the supply chain, whereas logistics management focuses, at an operational level, on managing the material flows delivered to a project site, examining companies' procurement and delivery process (inbound, internal and outbound logistics).",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2017",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        },
        {
          "@value": "Alaluusua, 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/käänteinen-logistiikka"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/toimitusketjun-hallinta"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/nimikkeistö-tai-luokitus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "Nimikkeistö (tai luokitus)",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "nomenklatur (eller klassificering)",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "classification",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Nimikkeistöillä tarkoitetaan tässä yhteydessä (nimikkeiden muodostama kokonaisuus) systemaattista ja standardisoitua luokittelua, jolla identifioidaan, koodataan ja nimetään fyysinen tuote, tuotteen osa tai komponentti, materiaali tai palvelu.",
          "@language": "fi"
        },
        {
          "@value": "Med nomenklaturer avses i detta sammanhang (den helhet som nomenklaturerna bildar) en systematisk och standardiserad klassificering med vilken en fysisk produkt, produktdel eller komponent, ett material eller en tjänst identifieras, kodas och namnges.",
          "@language": "sv"
        },
        {
          "@value": "In this context, classification refers to (the set formed by the classification items) a systematic and standardized categorization used to identify, code and name a physical product, product part or component, material or service.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Ympäristöministeriö, RASTI-projekti: 2019",
          "@language": "fi",
          "@id": "https://rastiprojekti.com/wp-content/uploads/2019/02/RASTI-strategia-v1.pdf"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/etim-standardi"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/komponentti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/luokitus"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/lokitiedosto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "lokitiedosto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "loggfil",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "log file",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "palvelimen automaattisesti luoma tiedosto, joka sisältää tietoa palvelimella tehdyistä toimenpiteistä",
          "@language": "fi"
        },
        {
          "@value": "fil som automatiskt skapas av en server och som innehåller information om aktiviteter som utförs på servern",
          "@language": "sv"
        },
        {
          "@value": "file automatically created by a server that maintains a record of its activities",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Lokitiedostoja käytetään järjestelmien valvontaan,\nvirheiden jäljittämiseen ja tietoturvatapahtumien\nanalysointiin.\n",
          "@language": "fi"
        },
        {
          "@value": "Loggfiler används för övervakning av system,\nfelsökning och analys av säkerhetshändelser.\n",
          "@language": "sv"
        },
        {
          "@value": "Log files are commonly used for system monitoring,\ntroubleshooting and security auditing.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsitemalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ontologia",
        "https://teemualaluusua.github.io/sanasto1/#/concept/lokitieto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/loki-"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-15T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/lot-laite",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "IoT-laite",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "IoT-enhet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "IoT device",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Termillä IoT-laite tarkoitetaan IoT-järjestelmän entiteettiä eli kohdeyksikköä, joka on vuorovaikutuksessa ja viestii fyysisen maailman kanssa havainnoimalla tai aktivoimalla. IoT-laite voi olla sensori tai toimilaite.",
          "@language": "fi"
        },
        {
          "@value": "Med termen IoT-enhet avses en IoT-systementitet, det vill säga en målenhet, som interagerar och kommunicerar med den fysiska världen genom att observera eller aktivera. En IoT-enhet kan vara en sensor eller ett ställdon.",
          "@language": "sv"
        },
        {
          "@value": "The term IoT device refers to an entity of an IoT system, i.e. a target unit, that interacts and communicates with the physical world by sensing or actuating. An IoT device can be a sensor or an actuator.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 22989:2023",
          "@language": "fi",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/lot-järjestelmä"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/anturi"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
