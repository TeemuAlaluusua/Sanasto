      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/iot",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "esineiden internet",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "sakernas internet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "internet of things",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "IoT",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "IoT",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "IoT",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Infrastruktuuri, joka koostuu toisiinsa yhdistetyistä\nentiteeteistä, kuten kohdeyksiköistä, ihmisistä,\njärjestelmistä ja informaatioresursseista, sekä\npalveluista, jotka käsittelevät fyysisestä ja\nvirtuaalimaailmasta tulevaa informaatiota ja\nreagoivat siihen.\n",
          "@language": "fi"
        },
        {
          "@value": "Infrastruktur som består av sammankopplade entiteter,\nsåsom enheter, människor, system och\ninformationsresurser, samt tjänster som behandlar\ninformation från den fysiska och virtuella världen\noch reagerar på den.\n",
          "@language": "sv"
        },
        {
          "@value": "Infrastructure consisting of interconnected entities\nsuch as devices, people, systems and information\nresources, together with services that process and\nrespond to information originating from the physical\nand virtual world.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "IoT viittaa usein laitteiden ja koneiden\nyhdistämiseen internetiin sekä niiden tuottaman\ndatan hyödyntämiseen yhdessä muiden tietolähteiden\nkanssa.\n",
          "@language": "fi"
        },
        {
          "@value": "IoT avser ofta sammankoppling av maskiner och\nenheter till internet samt användning av data\nsom genereras av dessa tillsammans med andra\ndatakällor.\n",
          "@language": "sv"
        },
        {
          "@value": "IoT commonly refers to connecting devices and\nmachines to the internet and integrating the\ndata they generate with other data sources.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 22989:2023",
          "@language": "en",
          "@id": "https://www.iso.org/standard/74296.html"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/lot-järjestelmä"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/anturi",
        "https://teemualaluusua.github.io/sanasto1/#/concept/big-data"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/mrp",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "materiaalitarvelaskenta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "materialbehovsplanering",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Manufacturing Resource Planning",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "MRP",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "MRP",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "MRP",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "MRP-ohjelmistosovellus, joka ohjaa ja aikatauluttaa materiaalivirtoja tuotannon vaatimusten mukaisesti.",
          "@language": "fi"
        },
        {
          "@value": "MRP-programvaruapplikation som styr och schemalägger materialflöden enligt produktionskrav.",
          "@language": "sv"
        },
        {
          "@value": "Software application (MRP) that controls and schedules material flows according to production requirements.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Materiaalitarvelaskenta (MRP) ohjaa materiaalien hankintaa ja tuotannon ajoitusta tuotantosuunnitelmien perusteella.\n",
          "@language": "fi"
        },
        {
          "@value": "Materialbehovsplanering (MRP) styr materialanskaffning och produktionsplanering baserat på produktionsplaner.\n",
          "@language": "sv"
        },
        {
          "@value": "Manufacturing Resource Planning (MRP) supports material procurement and production scheduling based on production plans.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 10303-240:2005",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-19T00:00",
        "@type": "xsd:dateTime"
      }
    },
