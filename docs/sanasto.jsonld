    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rakentamiskohteiden-informaation-mallinnus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "rakentamiskohteiden informaation mallinnus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "informationsmodellering av byggobjekt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "BIM",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Rakentamiskohteiden informaation mallinnuksella tarkoitetaan rakennetun ympäristön omaisuuskohteen yhteisen digitaalisen esityksen käyttöä suunnittelun, rakentamisen ja käytön helpottamiseksi, jotta päätöksenteolle saadaan luotettava perusta HUOM. Rakennettuja omaisuuskohteita ovat mm. rakennukset, sillat, tiet ja tuotantolaitokset.",
          "@language": "fi"
        },
        {
          "@value": "Med informationsmodellering av byggobjekt avses användningen av en gemensam digital representation av ett byggt tillgångsobjekt för att underlätta projektering, byggande och drift, så att beslutsfattandet får en tillförlitlig grund. OBS. Byggda tillgångsobjekt är bland annat byggnader, broar, vägar och produktionsanläggningar.",
          "@language": "sv"
        },
        {
          "@value": "Building information modelling refers to the use of a shared digital representation of a built asset to facilitate design, construction and operation, so as to provide a reliable basis for decision-making. NOTE: Built assets include, among others, buildings, bridges, roads and production facilities.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN/ISO 19650:2018",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/68078.html"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/bcf"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/malli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "malli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "modell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "model",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fyysinen, matemaattinen tai muuten looginen esitys\njärjestelmästä, entiteetistä, ilmiöstä, prosessista\ntai datasta.\n",
          "@language": "fi"
        },
        {
          "@value": "Fysisk, matematisk eller på annat sätt logisk\nrepresentation av ett system, en entitet, ett\nfenomen, en process eller data.\n",
          "@language": "sv"
        },
        {
          "@value": "Physical, mathematical or otherwise logical\nrepresentation of a system, entity, phenomenon,\nprocess or data.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Mallia käytetään kohteen kuvaamiseen, analysointiin,\nsimulointiin tai suunnitteluun.\n",
          "@language": "fi"
        },
        {
          "@value": "En modell används för att beskriva, analysera,\nsimulera eller planera ett system eller fenomen.\n",
          "@language": "sv"
        },
        {
          "@value": "A model is commonly used to describe, analyze,\nsimulate or design a system or phenomenon.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 22989:2023",
          "@language": "en",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsitemalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/mallinnus"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/projektituote",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "projektituote",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "projektprodukt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "project product",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Projektituotteilla tarkoitetaan yksittäistä projektia varten suunniteltuja ja tuotettuja tuotteita, jotka poikkeavat sarjavalmisteisista vakiotuotteista tuotteen ominaisuuksien, kuten mittojen tai suorituskyvyn perusteella, sekä rajatumman saatavuuden myötä. Projektituotteiden tuotannon ohjaus edellyttää suunnittelijoiden, tuotetoimittajien ja urakoitsijoiden välistä yhteistyötä. Projektituotteina on pidetty ETO-tuotantostrategian mukaisia suunnittelutuotteita. Lisäksi jotkin kauppatuotteet voidaan nähdä projektikohtaisina kokoonpanoina erilaisista vakiotuotteista, jolla viitataan ATO-tuotantostrategiaan.",
          "@language": "fi"
        },
        {
          "@value": "Med projektprodukter avses produkter som projekterats och tillverkats för ett enskilt projekt och som avviker från seriemässigt tillverkade standardprodukter i fråga om produktegenskaper, till exempel mått eller prestanda, samt genom en mer begränsad tillgänglighet. Styrning av produktionen av projektprodukter kräver samarbete mellan projektörer, produktleverantörer och entreprenörer. Projektprodukter har ansetts vara projekteringsprodukter enligt ETO-produktionsstrategin (engineer-to-order). Dessutom kan vissa handelsprodukter ses som projektspecifika sammansättningar av olika standardprodukter, vilket hänvisar till ATO-produktionsstrategin (assemble-to-order).",
          "@language": "sv"
        },
        {
          "@value": "Project products refer to products designed and manufactured for an individual project, which differ from mass-produced standard products in terms of product properties such as dimensions or performance, and through more limited availability. Controlling the production of project products requires cooperation between designers, product suppliers and contractors. Project products have been regarded as design products under the engineer-to-order (ETO) production strategy. In addition, some trade products can be seen as project-specific assemblies of various standard products, referring to the assemble-to-order (ATO) production strategy.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Alaluusua 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        },
        {
          "@value": "ISO 15489-1:2017",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/vakiotuote",
        "https://teemualaluusua.github.io/sanasto1/#/concept/eto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ato"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/lähtötiedot",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "lähtötiedot",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "utgångsuppgifter",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "initial data",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lähtötiedot ovat eri tietolähteistä saatua tai mitattua tuotteiden, toiminnan ja palveluiden suunnittelua varten hankittua informaatiota.",
          "@language": "fi"
        },
        {
          "@value": "Utgångsuppgifter är information som erhållits från eller mätts upp via olika informationskällor och som anskaffats för projektering av produkter, verksamhet och tjänster.",
          "@language": "sv"
        },
        {
          "@value": "Initial data is information obtained from or measured via various data sources, acquired for the design of products, operations and services.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Ympäristöministeriö, RASTI-projekti: 2019",
          "@language": "fi",
          "@id": "https://rastiprojekti.com/wp-content/uploads/2019/02/RASTI-strategia-v1.pdf"
        }
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/kolli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "kolli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "kolli",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "package",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Kollilla tarkoitetaan matka- tai rahtitavaran lähetyksen pienintä (tarkemmin määrittelemätöntä) kuljetusyksikköä. Jokainen kolli on varustettava niin sanotulla kolliosoitelapulla. Kolliosoitelapussa mainitaan muun muassa lähetyksen toimitusosoite, SSCC-koodi, kollin järjestysnumero ja paino sekä lähetyksen kokonaiskollimäärä ja kollien yhteispaino.",
          "@language": "fi"
        },
        {
          "@value": "Med kolli avses den minsta (närmare obestämda) transportenheten i en rese- eller fraktgodssändning. Varje kolli ska förses med en så kallad kollietikett. På kollietiketten anges bland annat sändningens leveransadress, SSCC-kod, kollits löpnummer och vikt samt sändningens totala antal kollin och kollinas sammanlagda vikt.",
          "@language": "sv"
        },
        {
          "@value": "A package refers to the smallest (not more precisely defined) shipping unit of a passenger or freight consignment. Each package must be fitted with a so-called package label. The package label states, among other things, the consignment's delivery address, SSCC code, the package's sequence number and weight, as well as the consignment's total number of packages and their combined weight.",
          "@language": "en"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/sscc"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/ydintieto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "ydintieto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "masterdata",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "master data",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "organisaation toimintaan liittyvää kohdetta kuvaava tieto, jota useampi organisaation prosessi tai toiminto tarvitsee tai hyödyntää",
          "@language": "fi"
        },
        {
          "@value": "information som beskriver ett objekt kopplat till organisationens verksamhet och som används eller behövs av flera processer eller funktioner inom organisationen",
          "@language": "sv"
        },
        {
          "@value": "the authoritative, most accurate data that is available about key business entities, used to establish the context for business transactions and transactional data",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Organisaation masterdataa voivat olla esimerkiksi asiakkaita, toimittajia, yhteistyökumppaneita, tuotteita, palveluita tai toimipaikkoja koskevat tiedot. Tavallisesti master data on hitaasti muuttuvaa ja sen tarve on pitkäaikaista.",
          "@language": "fi"
        },
        {
          "@value": "Organisationens masterdata kan till exempel omfatta uppgifter om kunder, leverantörer, samarbetspartner, produkter, tjänster eller verksamhetsställen. Masterdata förändras vanligtvis långsamt och används under lång tid.",
          "@language": "sv"
        },
        {
          "@value": "Master data in an organization may include information about customers, suppliers, partners, products, services or locations. Master data is typically slowly changing and used over a long period.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-58"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/lokitieto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "lokitieto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "loggdata",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "log data",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "tietojärjestelmän muistiin automaattisesti kirjautuva tapahtumatieto",
          "@language": "fi"
        },
        {
          "@value": "händelseinformation som automatiskt registreras i ett informationssystems minne",
          "@language": "sv"
        },
        {
          "@value": "event information that is automatically recorded in the memory of an information system",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-59"
        },
        {
          "@value": "ISO 26430-4:2009",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/lokitiedosto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietoturva",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tapahtumatieto"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
