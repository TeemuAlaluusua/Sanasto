        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/ginc",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "logistisen kuljetusvaiheen tunniste",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "globalt identifieringsnummer för sändning",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Global Identification Number for Consignment",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "GINC",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "GINC",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "GINC",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "GINC on GS1:n yksilöinnin standardi, jota käytetään yksilöimään yhden tai useamman logistisen yksikön muodostama lähetys, joka on tarkoitettu kuljetettavaksi yhdessä ja dokumentoidaan samalle kuljetusasiakirjalle.",
          "@language": "fi"
        },
        {
          "@value": "GINC är en GS1-identifieringsstandard som används för att identifiera en sändning som består av en eller flera logistiska enheter avsedda att transporteras tillsammans, dokumenterade under samma transportdokument.",
          "@language": "sv"
        },
        {
          "@value": "GINC is a GS1 identification standard used to identify a consignment formed of one or more logistics units that are intended to be transported together and documented on the same transport document.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "GS1 yksilöinti standardit",
          "@language": "fi",
          "@id": "https://www.gs1.org/standards/id-keys"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/xpath",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "XML Path Language",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "XPath",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "XML Path Language",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "XPath",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "XML Path Language",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "XPath",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "lausekieli, jolla osoitetaan ja käsitellään XML- ja JSON-rakenteiden solmuja",
          "@language": "fi"
        },
        {
          "@value": "uttrycksspråk för att adressera och bearbeta noder i XML- och JSON-strukturer",
          "@language": "sv"
        },
        {
          "@value": "expression language for addressing and processing nodes in XML and JSON data structures",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "XPath käyttää polkulausekkeita (path expressions), joilla voidaan navigoida\nXML-dokumentin hierarkkisessa rakenteessa.\n",
          "@language": "fi"
        },
        {
          "@value": "XPath toimii tyypillisesti osana muita kieliä, kuten XSLT ja XQuery,\neikä sitä yleensä käytetä itsenäisenä ohjelmointikielenä.\n",
          "@language": "fi"
        },
        {
          "@value": "XPath 3.1 tukee XML:n lisäksi myös JSON-rakenteita sekä tietomallia,\njoka sisältää solmuja, atomisia arvoja, funktioita ja sekvenssejä.\n",
          "@language": "fi"
        },
        {
          "@value": "XPath använder sökuttryck (path expressions) för att navigera i hierarkiska\nXML-strukturer.\n",
          "@language": "sv"
        },
        {
          "@value": "XPath uses path expressions to navigate hierarchical structures of XML documents.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "W3C XPath 3.1 Recommendation",
          "@language": "en",
          "@id": "https://www.w3.org/TR/xpath-31/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/xml",
        "https://teemualaluusua.github.io/sanasto1/#/concept/json"
      ],
      "dcterms:created": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/looginen-tietomalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "looginen tietomalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "logisk datamodell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "logical data model",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "tietomalli, joka kuvaa tiedot ja tietorakenteet loogisella tasolla",
          "@language": "fi"
        },
        {
          "@value": "datamodell som beskriver data och datastrukturer på en logisk nivå",
          "@language": "sv"
        },
        {
          "@value": "data model that describes data and data structures at a logical level",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Looginen tietomalli kuvaa tarkastelun kohteena olevat luokat, niiden väliset assosiaatiot (suhteet) ja luokkiin sisältyvät attribuutit.",
          "@language": "fi"
        },
        {
          "@value": "Looginen tietomalli on käsitemallista tarkemmalle tasolle viety kuvaus.",
          "@language": "fi"
        },
        {
          "@value": "Den logiska datamodellen beskriver de klasser som analyseras, relationerna (associationerna) mellan dem samt de attribut som ingår i klasserna.",
          "@language": "sv"
        },
        {
          "@value": "Den logiska datamodellen är en mer detaljerad beskrivning än en begreppsmodell.",
          "@language": "sv"
        },
        {
          "@value": "The logical data model describes the classes under consideration, the associations (relationships) between them, and the attributes contained within the classes.",
          "@language": "en"
        },
        {
          "@value": "The logical data model is a more detailed representation than a conceptual model.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-73"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsitteellinen-tietomalli"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/fyysinen-tietomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsitemalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsiteskeema",
        "https://teemualaluusua.github.io/sanasto1/#/concept/luokka",
        "https://teemualaluusua.github.io/sanasto1/#/concept/attribuutti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/assosiaatio"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/ifcowl",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "ifcOWL",
          "@language": "fi",
