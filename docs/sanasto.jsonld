    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/juurisyyanalyysi-rca",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "juurisyyanalyysi (RCA)",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "rotorsaksanalys",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "root cause analysis",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Toiminto, joka tunnistaa häiriön tai ongelman perussyyn.",
          "@language": "fi"
        },
        {
          "@value": "En funktion som identifierar grundorsaken till en störning eller ett problem.",
          "@language": "sv"
        },
        {
          "@value": "A function that identifies the root cause of a disturbance or problem.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC/IEEE 24765:2017",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/juurisyy"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/digitaalinen-identiteetti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "digitaalinen identiteetti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "digital identitet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "digital identity",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Identiteetti, joka muodostuu digitaalisista yksilöintitiedoista. Digitaalisen identiteetin avulla yritys (tai muu toimija tai objekti) voidaan tunnistaa luotettavasti ja yritys voi toimia täysipainoisesti jakaen verkossa itseään koskevia vahvistettuja tietoja.",
          "@language": "fi"
        },
        {
          "@value": "En identitet som består av digitala individualiseringsuppgifter. Med hjälp av den digitala identiteten kan ett företag (eller en annan aktör eller ett objekt) identifieras på ett tillförlitligt sätt, och företaget kan fullt ut agera genom att dela verifierade uppgifter om sig själv på nätet.",
          "@language": "sv"
        },
        {
          "@value": "An identity formed of digital identification data. A digital identity enables a company (or another actor or object) to be reliably identified, and allows the company to operate fully by sharing verified information about itself online.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastot",
          "@language": "fi",
          "@id": "https://sanastot.suomi.fi/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/yksilöinti"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/alavirta",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "alavirta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "nedströms",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "downstream",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Toimitusketjun osa, joka kattaa vaiheet ja toimijat raaka-ainetoimittajista kokoonpanevaan tai tuottavaan yksikköön. Vastakohta ylävirralle. Käytetään myös nimitystä jakelumarkkinat.",
          "@language": "fi"
        }
      ],
      "skos:note": [
        {
          "@value": "Termiä käytetään toimitusketjun tarkastelussa kuvaamaan virtausta kohti\nkokoonpanoa tai tuotantoa. Rakentamisen kontekstissa alavirta voi tarkoittaa\nesimerkiksi materiaalien ja komponenttien toimitusketjua työmaalle tai\nelementtitehtaalle.\n",
          "@language": "fi"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Logistiikan maailma -termisanasto (2025)",
          "@id": "https://www.logistiikanmaailma.fi/aineistot/sanastot/logistiikan-maailma-termisanasto/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/ylävirta"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-26T10:15:35",
        "@type": "xsd:dateTime"
      }
    },
    {
