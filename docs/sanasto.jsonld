        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/wip",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "WIP",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "WIP",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "work in progress",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "WIP-termi kuvaa työn vaihetta tai tilaa, joka tarkoittaa, että toimenpiteet ovat alkaneet, mutta niitä ei ole vielä saatettu päätökseen. Käytetään yleisesti häiriöiden, ongelmien, muutosten jne. tilana.",
          "@language": "fi"
        },
        {
          "@value": "Termen WIP beskriver ett skede eller tillstånd i arbetet som innebär att åtgärderna har påbörjats men ännu inte slutförts. Används allmänt för att beskriva tillståndet för störningar, problem, ändringar med mera.",
          "@language": "sv"
        },
        {
          "@value": "The term WIP describes a stage or state of work meaning that activities have begun but have not yet been completed. Commonly used to describe the state of disturbances, problems, changes, etc.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 22468:2020",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/73292.html"
        }
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/ohjelmointirajapinta",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "ohjelmointirajapinta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "programmeringsgränssnitt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "application programming interface",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "API",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "rajapinta",
          "@language": "fi",
          "termType": "Synonyymi"
        },
        {
          "@value": "API",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "API",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Määritelmä, jonka mukaan eri sovellukset voivat tehdä pyyntöjä ja vaihtaa tietoja keskenään.",
          "@language": "fi"
        },
        {
          "@value": "Definition som gör det möjligt för olika applikationer att göra förfrågningar och utbyta data med varandra.",
          "@language": "sv"
        },
        {
          "@value": "Definition that allows different applications to make requests and exchange data with each other.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Rajapinta voi olla pelkkä datarajapinta, jonka kautta voidaan lukea palvelun sisältämää dataa toisiin järjestelmiin.\nEsimerkki ohjelmointirajapinnasta on käyttöjärjestelmän rajapinta, jolla ohjelmat voivat käyttää keskusmuistia ja tiedostoja.\n",
          "@language": "fi"
        },
        {
          "@value": "Gränssnittet kan vara ett rent datagränssnitt genom vilket data från en tjänst kan läsas till andra system.\nEtt exempel är operativsystemets gränssnitt som gör det möjligt för program att använda minne och filer.\n",
          "@language": "sv"
        },
        {
          "@value": "The interface may be a data interface through which data from a service can be accessed by other systems.\nAn example is an operating system interface that allows programs to use memory and files.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastot.suomi.fi",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yritysdigi/concept-2000"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rajapinta"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rest-ohjelmistorajapinta"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-19T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/gdti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "dokumentin tunniste",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "global dokumenttypidentifierare",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Global Document Type Identifier",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "GDTI",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "GDTI",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "GDTI",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "GDTI on GS1:n yksilöinnin standardi, jota käytetään yksilöimään erilaisia dokumenttityyppejä, kuten laskuja tai kuljetusasiakirjoja.",
          "@language": "fi"
        },
        {
          "@value": "GDTI är en GS1-identifieringsstandard som används för att identifiera olika dokumenttyper, såsom fakturor eller transportdokument.",
          "@language": "sv"
        },
        {
          "@value": "GDTI is a GS1 identification standard used to identify different document types, such as invoices or transport documents.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "GS1 yksilöinti standardit",
          "@language": "fi",
          "@id": "https://www.gs1.org/standards/id-keys"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/informaatio",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "informaatio",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "information",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "information",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "datan uudelleen tulkittavissa oleva sovitun muotoinen esitystapa, joka sopii tiedonsiirtoon, viestintään, tulkintaan tai käsittelyyn",
          "@language": "fi"
        },
        {
          "@value": "överenskommen form av data som kan tolkas på nytt och som lämpar sig för överföring, kommunikation, tolkning eller behandling",
          "@language": "sv"
        },
        {
          "@value": "agreed form of data that can be reinterpreted and that is suitable for transmission, communication, interpretation or processing",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Informaatiota voi käsitellä ihminen tai sitä voidaan käsitellä automaattisin menetelmin.",
          "@language": "fi"
        },
        {
          "@value": "Information kan behandlas av människor eller automatiskt med tekniska metoder.",
          "@language": "sv"
        },
        {
          "@value": "Information may be processed by humans or automatically by technical means.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Suomi.fi-sanasto – EN 19650 käsitteet",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/en19650/concept-17"
        },
        {
          "@value": "ISO 19650-1:2019"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/data"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/data"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiomalli"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/käsiteskeema",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "käsiteskeema",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "begreppsschema",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "conceptual schema",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Käsitemallin muodollinen kuvailu, joka esittää\nkohdealueen käsitteet, niiden ominaisuudet ja\nsuhteet rakenteisessa muodossa.\n",
          "@language": "fi"
        },
        {
          "@value": "Formell beskrivning av en begreppsmodell som\nanger begrepp i ett visst område samt deras\negenskaper och relationer i strukturerad form.\n",
          "@language": "sv"
        },
        {
          "@value": "Formal description of a conceptual model that\nspecifies the concepts of a domain together\nwith their properties and relationships.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Käsiteskeema esittää käsitemallin muodollisessa\nmuodossa ja sitä voidaan käyttää tietomallien\nsuunnittelun ja tietojärjestelmien kehittämisen\nlähtökohtana.\n",
          "@language": "fi"
        },
        {
          "@value": "Ett begreppsschema uttrycker en begreppsmodell\ni formell form och används ofta som grund för\nutveckling av informationsmodeller och\ninformationssystem.\n",
          "@language": "sv"
        },
        {
          "@value": "A conceptual schema expresses a conceptual model\nin a formalized structure and can serve as a basis\nfor designing information models and information\nsystems.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en",
          "@id": "https://www.iso.org/standard/59743.html"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsitemalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/skeema"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/ontologia"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/assosiaatio",
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsitteellinen-tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/looginen-tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/luokka"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tekninen-yhteentoimivuus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tekninen yhteentoimivuus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "teknisk interoperabilitet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "technical interoperability",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "yhteentoimivuus, joka mahdollistaa tietotekniikan avulla tehtävät tiedonsiirrot",
          "@language": "fi"
        },
        {
          "@value": "interoperabilitet som gör det möjligt att överföra information med hjälp av informationsteknik",
          "@language": "sv"
        },
        {
          "@value": "form of interoperability that enables the transfer of data via information technology",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Tekninen yhteentoimivuus liittyy tekniseen, laitteista ja ohjelmista koostuvaan osaan tietojärjestelmiä. Teknisellä yhteentoimivuudella saavutettavat edut ovat rajallisia, jos tietojärjestelmien välillä ei ole semanttista, organisatorista tai oikeudellista yhteentoimivuutta.",
          "@language": "fi"
        },
        {
          "@value": "Teknisk interoperabilitet hänför sig till den tekniska delen av informationssystem, dvs. hårdvara och programvara. Fördelarna med teknisk interoperabilitet är begränsade om det inte finns semantisk, organisatorisk eller juridisk interoperabilitet mellan informationssystemen.",
          "@language": "sv"
        },
        {
          "@value": "Technical interoperability is connected to the technical part of information systems, i.e. hardware and software. However, the benefits of technical interoperability are limited if there is no semantic, organisational or legal interoperability between the information systems.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-42"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/yhteentoimivuus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/semanttinen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/organisatorinen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/oikeudellinen-yhteentoimivuus"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/yksilöintitieto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "yksilöintitieto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "identifieringsuppgift",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "identifying information",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tieto tai tietojoukko, jonka avulla toimija, kohde tai tietomallin objekti voidaan yksiselitteisesti tunnistaa ja erottaa muista.",
          "@language": "fi"
        },
        {
          "@value": "Uppgift eller uppsättning uppgifter med vilka en aktör, ett objekt eller ett objekt i en informationsmodell kan identifieras entydigt och särskiljas från andra.",
          "@language": "sv"
        },
        {
          "@value": "Information or a set of information by which an actor, an object or an object in an information model can be uniquely identified and distinguished from others.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Yksilöintitieto voi olla yksittäinen tunniste (esim. tunnus, koodi, GUID) tai tunnisteiden yhdistelmä. Rakentamisen tietomalleissa yksilöintitieto liitetään esimerkiksi rakennusosiin, järjestelmiin, tiloihin ja laitteisiin elinkaaren aikaisen jäljitettävyyden ja hallinnan varmistamiseksi.",
          "@language": "fi"
        },
        {
          "@value": "Identifieringsuppgifter kan vara en enskild identifierare (t.ex. beteckning, kod, GUID) eller en kombination av identifierare. I byggandets informationsmodeller kopplas identifieringsuppgifter till exempel till byggnadsdelar, system, utrymmen och utrustning för att säkerställa spårbarhet och hantering under livscykeln.",
          "@language": "sv"
        },
        {
          "@value": "Identifying information can consist of a single identifier (e.g. identifier, code, GUID) or a combination of identifiers. In construction information models, identifying information is associated for example with building elements, systems, spaces and equipment to ensure lifecycle traceability and management.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Suomi.fi-sanastot: Yritysdigi – yksilöintitieto",
          "@language": "fi",
          "@id": "https://sanastot.suomi.fi/terminology/yritysdigi/concept/concept-2062"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/uri",
        "https://teemualaluusua.github.io/sanasto1/#/concept/yksilöinti"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-27T10:48:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/ifcql",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "IfcQL",
