    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/alkuperäisformaatti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "alkuperäisformaatti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "nativt format",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "native format",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "natiiviformaatti",
          "@language": "fi",
          "termType": "Synonyymi"
        },
        {
          "@value": "natiivimalli",
          "@language": "fi",
          "termType": "Synonyymi"
        },
        {
          "@value": "ursprungsformat",
          "@language": "sv",
          "termType": "Synonyymi"
        },
        {
          "@value": "nativt filformat",
          "@language": "sv",
          "termType": "Synonyymi"
        },
        {
          "@value": "native file format",
          "@language": "en",
          "termType": "Synonyymi"
        },
        {
          "@value": "proprietary format",
          "@language": "en",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mallinnusohjelman oma tallennusformaatti. Rakennusalan julkaisuissa käytetään\ntälle synonyyminä käsitteitä natiivimalli tai natiiviformaatti.\n",
          "@language": "fi"
        },
        {
          "@value": "Det filformat som är specifikt för ett visst modelleringsprogram och dess\ninterna lagring av modellen. Inom byggbranschen används även benämningarna\nnativ modell eller nativt format som synonymer.\n",
          "@language": "sv"
        },
        {
          "@value": "The file format specific to a particular modelling software used for the\nmodel’s native storage. In the construction industry, the terms native model\nor native format are also used as synonyms.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "BEC:2023 Elementtisuunnittelun mallinnusohje",
          "@language": "fi",
          "@id": "https://www.elementtisuunnittelu.fi/Download/23982/BEC2012%20Elementtisuunnittelun%20mallinnusohje_v110.pdf"
        },
        {
          "@value": "YTV:2012 Yleiset tietomallivaatimukset",
          "@language": "fi",
          "@id": "https://wiki.buildingsmart.fi/fi/04_Julkaisut_ja_Standardit/YTV"
        }
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-27T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tahtiaikataulu",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tahtiaikataulu",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "taktschema",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "takt schedule",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tahtiaikataulu on tahtisuunnittelun tuotoksena syntyvä ja tahtiohjauksen kautta ohjattava aikataulu, joka kertoo missä, miten ja millä resusseilla hankkeen ja tuotannon eri tehtäviä toteutetaan.",
          "@language": "fi"
        },
        {
          "@value": "Taktschemat är ett tidsschema som tas fram som ett resultat av taktplaneringen och som styrs genom taktstyrning. Det anger var, hur och med vilka resurser projektets och produktionens olika uppgifter genomförs.",
          "@language": "sv"
        },
        {
          "@value": "A takt schedule is a schedule produced as a result of takt planning and controlled through takt control. It indicates where, how and with what resources the various tasks of the project and production are carried out.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RIL, Tahtituotanto:2024",
          "@language": "fi",
          "@id": "https://view.taiqa.com/ril/tahtituotanto-opas-2-2024#/page=1"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tahtituotanto"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/käsitemalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "käsitemalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "begreppsmodell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "conceptual schema",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tietomalli, joka määrittelee kohdealueen käsitteet\nja niiden väliset suhteet.\n",
          "@language": "fi"
        },
        {
          "@value": "Informationsmodell som definierar begreppen\ni ett visst verksamhetsområde och relationerna\nmellan dem.\n",
          "@language": "sv"
        },
        {
          "@value": "Model that defines the concepts of a universe\nof discourse and the relationships between them.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Käsitemalli kuvaa kohdealueen keskeiset käsitteet\nja niiden väliset suhteet riippumatta\ntietojärjestelmien teknisestä toteutuksesta.\n",
          "@language": "fi"
        },
        {
          "@value": "En begreppsmodell beskriver centrala begrepp i ett\nverksamhetsområde och relationerna mellan dem\noberoende av teknisk implementation.\n",
          "@language": "sv"
        },
        {
          "@value": "A conceptual schema describes the core concepts\nof a domain and the relationships between them\nindependent of technical implementation.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/malli"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsiteskeema",
        "https://teemualaluusua.github.io/sanasto1/#/concept/lokitiedosto"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/ontologia",
        "https://teemualaluusua.github.io/sanasto1/#/concept/skeema",
        "https://teemualaluusua.github.io/sanasto1/#/concept/fyysinen-tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/looginen-tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomallinnus"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/nosql-tietokanta",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "NoSQL-tietokanta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "NoSQL-databas",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "NoSQL database",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "NoSQL-tietokanta on tietokantajärjestelmä, joka eroaa perinteisistä relaatiotietokannoista siinä, että se ei noudata relaatiomallia tai SQL-kieltä. Sen sijaan NoSQL-tietokannat tarjoavat joustavamman datamallin, joka soveltuu erityisesti hajautettuihin ja skaalautuviin ympäristöihin.",
          "@language": "fi"
        },
        {
          "@value": "En NoSQL-databas är ett databassystem som skiljer sig från traditionella relationsdatabaser genom att det inte följer relationsmodellen eller SQL-språket. NoSQL-databaser erbjuder i stället en mer flexibel datamodell som lämpar sig särskilt väl för distribuerade och skalbara miljöer.",
          "@language": "sv"
        },
        {
          "@value": "A NoSQL database is a database system that differs from traditional relational databases in that it does not follow the relational model or the SQL language. Instead, NoSQL databases offer a more flexible data model that is particularly well suited to distributed and scalable environments.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietokanta"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/sql-kieli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/relaatiotietokanta"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/eto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "asiakasohjautuva tuotesuunnittelu",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "kundorderstyrd konstruktion",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "engineer-to-order",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "ETO",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "ETO",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "ETO",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "tuotantomenetelmä, jossa tuote suunnitellaan ja valmistetaan asiakaskohtaisen tilauksen perusteella",
          "@language": "fi"
        },
        {
          "@value": "produktionsmetod där produkten konstrueras och tillverkas utifrån en kundspecifik beställning",
          "@language": "sv"
        },
        {
          "@value": "production strategy in which a product is designed and manufactured based on a specific customer order",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "ETO-mallissa asiakastilauksen kytkentäpiste sijaitsee\ntuotesuunnitteluvaiheessa. Tuotteet ovat yleensä\nasiakaskohtaisesti kustomoituja, mikä johtaa\npidempiin toimitusaikoihin ja korkeampiin\ntuotantokustannuksiin.\n",
          "@language": "fi"
        },
        {
          "@value": "I ETO-modellen ligger kundorderpunkten i\nkonstruktionsfasen. Produkterna är vanligtvis\nkundanpassade, vilket ofta innebär längre\nleveranstider och högre produktionskostnader.\n",
          "@language": "sv"
        },
        {
          "@value": "In the ETO model the customer order decoupling\npoint occurs in the design phase. Products are\ntypically customised, which often results in\nlonger lead times and higher production costs.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Alaluusua, 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        },
        {
          "@value": "Peltokorpi, 2020",
          "@language": "fi",
          "@id": "https://www.aalto.fi/sites/default/files/2020-11/Loppuraportti_Tuotetiedon%20hallinta%20ja%20hyo%CC%88dynta%CC%88minen_2.11.2020_0.pdf"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tuotantomuoto"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/dto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/mto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ato",
        "https://teemualaluusua.github.io/sanasto1/#/concept/mts",
        "https://teemualaluusua.github.io/sanasto1/#/concept/projektituote"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/oir",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "organisatoriset informaatiovaatimukset",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "organisatoriska informationskrav",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "organizational information requirements",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "OIR",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "OIR",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "OIR",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Organisaation strategisiin tavoitteisiin perustuvat informaatiovaatimukset, joilla kuvataan mitä tietoa organisaatio tarvitsee omaisuuskohteidensa ja toimintansa johtamiseen.",
          "@language": "fi"
        },
        {
          "@value": "Informationskrav som grundar sig på organisationens strategiska mål och som beskriver vilken information organisationen behöver för att leda sina tillgångar och sin verksamhet.",
          "@language": "sv"
        },
        {
          "@value": "Information requirements in relation to organizational objectives, describing what information an organization needs to manage its assets and operations.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "OIR on ISO 19650 -standardin mukaisen informaatiovaatimushierarkian\nylin taso, josta johdetaan omaisuuskohteen informaatiovaatimukset\n(AIR) ja projektin informaatiovaatimukset (PIR).\n",
          "@language": "fi"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN ISO 19650-1:2018",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/68078.html"
        },
        {
          "@value": "Suomi.fi-sanasto EN 19650",
          "@language": "fi",
          "@id": "https://sanastot.suomi.fi/terminology/en19650/concept-19"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiovaatimus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/air",
        "https://teemualaluusua.github.io/sanasto1/#/concept/pir",
        "https://teemualaluusua.github.io/sanasto1/#/concept/eir"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/esitysformaatti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "esitysformaatti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "presentationsformat",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "presentation format",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "dataformaatti, jonka avulla digitaalinen data esitetään näyttöruudulla niin, että ihmiset pystyvät tulkitsemaan sitä",
          "@language": "fi"
        },
        {
          "@value": "dataformat som används för att presentera digital data på en skärm så att människor kan tolka informationen",
          "@language": "sv"
        },
        {
          "@value": "data format for the configuration of the display of digital data on the screen interface in a manner interpretable for human users",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Esitysformaatti määrittelee, miten digitaalinen tieto esitetään\nkäyttäjälle visuaalisessa käyttöliittymässä. Se voi sisältää esimerkiksi\ntekstin, taulukoiden, kuvien, karttojen tai muiden graafisten elementtien\nesitystavan. Esitysformaatti eroaa tallennusformaatista siinä, että se\nkeskittyy tiedon esittämiseen ihmiselle eikä sen tekniseen tallennukseen.\n",
          "@language": "fi"
        },
        {
          "@value": "Presentationsformat anger hur digital information visas för användaren\ni ett visuellt gränssnitt. Det kan omfatta till exempel hur text,\ntabeller, bilder, kartor eller andra grafiska element presenteras.\nPresentationsformat skiljer sig från lagringsformat genom att fokus\nligger på hur informationen presenteras för människor snarare än hur\nden lagras tekniskt.\n",
          "@language": "sv"
        },
        {
          "@value": "A presentation format defines how digital information is displayed to\nusers in a visual interface. It may include the presentation of text,\ntables, images, maps, or other graphical elements. A presentation\nformat differs from a storage format in that it focuses on how data is\npresented to humans rather than how it is technically stored.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022 Information and documentation — Foundation and vocabulary",
          "@language": "en"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/dataformaatti"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/yksilöinti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "yksilöinti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "identifiering",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "identification",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Toimijan, kohteen tai tietomallin objektin yksiselitteinen tunnistaminen ja erottaminen muista samaan joukkoon kuuluvista.",
          "@language": "fi"
        },
        {
          "@value": "Entydig identifiering av en aktör, ett objekt eller ett objekt i en informationsmodell samt särskiljning från andra som tillhör samma mängd.",
          "@language": "sv"
        },
        {
          "@value": "Unambiguous identification of an actor, an object or an object in an information model and distinguishing it from others belonging to the same set.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Yksilöinti toteutetaan liittämällä kohteeseen yksilöintitieto, kuten tunnus, koodi tai globaalitunniste (esim. GUID). Rakentamisen tietomalleissa yksilöinti mahdollistaa objektien elinkaaren aikaisen viittauksen, jäljitettävyyden ja tiedonhallinnan.",
          "@language": "fi"
        },
        {
          "@value": "Identifiering genomförs genom att koppla en identifieringsuppgift till objektet, såsom en beteckning, kod eller global identifierare (t.ex. GUID). I byggandets informationsmodeller möjliggör identifiering livscykelbaserad referens, spårbarhet och informationshantering av objekt.",
          "@language": "sv"
        },
        {
          "@value": "Identification is implemented by associating identifying information with the object, such as an identifier, code or global identifier (e.g. GUID). In construction information models, identification enables lifecycle referencing, traceability and information management of objects.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Suomi.fi-sanastot: Yritysdigi – yksilöinti",
          "@language": "fi",
          "@id": "https://sanastot.suomi.fi/terminology/yritysdigi/concept/concept-2065"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/yksilöintitieto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tunniste",
        "https://teemualaluusua.github.io/sanasto1/#/concept/guid-tunniste",
        "https://teemualaluusua.github.io/sanasto1/#/concept/digitaalinen-identiteetti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/instanssitieto"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T10:55:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/relaatiotietokanta",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "relaatiotietokanta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "relationsdatabas",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "relational database",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Relaatiotietokanta on tietokantajärjestelmä, joka perustuu relaatiomalliin. Relaatiomalli kuvaa tietokannan tietorakenteen taulukoiden ja niiden välillä olevien suhteiden avulla. Jokainen tietokannan taulu sisältää rivejä, joista jokainen edustaa yhtä tietueetta, ja sarakkeita, jotka määrittävät tietueen ominaisuudet. Relaatiotietokannat käyttävät SQL-kieltä tietojen kyselyyn ja hallintaan. Yleisiä relaatiotietokantoja ovat esimerkiksi PostgreSQL, MySQL, Oracle Database ja Microsoft SQL Server.",
          "@language": "fi"
        },
        {
          "@value": "En relationsdatabas är ett databassystem som bygger på relationsmodellen. Relationsmodellen beskriver databasens datastruktur med hjälp av tabeller och relationerna mellan dem. Varje tabell i databasen innehåller rader, där varje rad representerar en post, och kolumner, som definierar postens egenskaper. Relationsdatabaser använder SQL-språket för att fråga och hantera data. Vanliga relationsdatabaser är till exempel PostgreSQL, MySQL, Oracle Database och Microsoft SQL Server.",
          "@language": "sv"
        },
        {
          "@value": "A relational database is a database system based on the relational model. The relational model describes the database's data structure using tables and the relationships between them. Each table in the database contains rows, each representing one record, and columns, which define the record's properties. Relational databases use the SQL language to query and manage data. Common relational databases include PostgreSQL, MySQL, Oracle Database and Microsoft SQL Server.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietokanta"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/nosql-tietokanta",
        "https://teemualaluusua.github.io/sanasto1/#/concept/sql-kieli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/relaatiotietomalli"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tekoäly",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tekoäly",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "artificiell intelligens, AI",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "AI",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tekoäly on tietojenkäsittelytieteen osa-alue, jonka tarkoituksena on kehittää tietojenkäsittelyjärjestelmiä, jotka suorittavat normaalisti ihmisen älykkyyteen liittyviä toimintoja, kuten päättelyä, oppimista ja itsensä parantamista.",
          "@language": "fi"
        },
        {
          "@value": "Artificiell intelligens (AI) är ett delområde inom datavetenskap som syftar till att utveckla databehandlingssystem som utför funktioner som normalt förknippas med mänsklig intelligens, såsom resonemang, inlärning och självförbättring.",
          "@language": "sv"
        },
        {
          "@value": "Artificial intelligence (AI) is a branch of computer science that aims to develop data processing systems capable of performing functions normally associated with human intelligence, such as reasoning, learning and self-improvement.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 2382:2015",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/63598.html"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/big-data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/koneoppiminen"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-tietomalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "rakennuskohteen tietomalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "datamodell av byggnadsobjekt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data model for construction entity",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "tietomalli, joka on tarkoitettu rakennuskohteen tietojen kuvaamiseen",
          "@language": "fi"
        },
        {
          "@value": "datamodell avsedd för att beskriva uppgifter om byggnadsobjektet",
          "@language": "sv"
        },
        {
          "@value": "data model intended for describing information on the construction entity",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Käsitejärjestelmäkaavio: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "fi"
        },
        {
          "@value": "Sekä talonrakennuksen että infrarakentamisen kohteet ovat rakennuskohteita.",
          "@language": "fi"
        },
        {
          "@value": "Rakennuskohteen tietomalli esitetään usein koneluettavassa muodossa.",
          "@language": "fi"
        },
        {
          "@value": "Begreppssystemschema: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "sv"
        },
        {
          "@value": "Både husbyggnads- och infrastrukturobjekt är byggnadsobjekt.",
          "@language": "sv"
        },
        {
          "@value": "Byggnadsobjektets datamodell presenteras ofta i maskinläsbar form.",
          "@language": "sv"
        },
        {
          "@value": "Concept system diagram: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "en"
        },
        {
          "@value": "Both building construction and infrastructure construction entities are construction entities.",
          "@language": "en"
        },
        {
          "@value": "A construction entity's data model is often presented in machine-readable form.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastokeskus, RY-mallit -sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rymallit/c8"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakentamisen-lupapaatosten-tietomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohde",
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-tietomallinnus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/toteutusmalli--tuotantomalli"
      ],
      "dcterms:created": {
