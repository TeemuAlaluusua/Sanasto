    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/mts",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "varasto-ohjautuva tuotanto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "lagerstyrd produktion",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "make-to-stock",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "MTS",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "MTS",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "MTS",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tuotantomuoto, jossa tuotteita valmistetaan varastoon ennakoidun kysynnän perusteella.",
          "@language": "fi"
        },
        {
          "@value": "Produktionsform där produkter tillverkas för lager baserat på prognostiserad efterfrågan.",
          "@language": "sv"
        },
        {
          "@value": "Production strategy in which goods are manufactured for stock based on forecasted demand.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Varasto-ohjautuvaa tuotantomuotoa käytetään tyypillisesti tuotteissa, joiden kysyntä on ennustettavissa.\nAsiakastilauksen kytkentäpiste sijaitsee lopputuotevarastossa, josta tuotteet toimitetaan asiakkaalle.\nTuotteita valmistetaan sisäisten tuotantotilausten perusteella varastoon, usein suurina määrinä mittakaavaetujen saavuttamiseksi.\nTuotantomuoto sitoo pääomaa, ja valmistusmäärän optimointi riippuu kysyntäennusteiden tarkkuudesta.\n",
          "@language": "fi"
        },
        {
          "@value": "Lagerstyrd produktion används typiskt för produkter med förutsägbar efterfrågan.\nKundorderpunkten finns i färdigvarulagret, varifrån produkterna levereras till kunden.\nProdukter tillverkas för lager baserat på interna produktionsorder, ofta i stora volymer för att uppnå stordriftsfördelar.\nProduktionsformen binder kapital och den optimala tillverkningsmängden beror på prognosernas noggrannhet.\n",
          "@language": "sv"
        },
        {
          "@value": "Make-to-stock is typically used for products with predictable demand.\nThe customer order decoupling point is located at the finished goods inventory, from which products are delivered to customers.\nProducts are manufactured to stock based on internal production orders, often in large volumes to achieve economies of scale.\nThe production strategy ties up capital, and the optimal production quantity depends on the accuracy of demand forecasts.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Alaluusua 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        },
        {
          "@value": "Peltokorpi 2020",
          "@language": "fi",
          "@id": "https://www.aalto.fi/sites/default/files/2020-11/Loppuraportti_Tuotetiedon%20hallinta%20ja%20hyo%CC%88dynta%CC%88minen_2.11.2020_0.pdf"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tuotantomuoto"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/mto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/eto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ato",
        "https://teemualaluusua.github.io/sanasto1/#/concept/vakiotuote"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-19T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/informaation-vaihto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "informaation vaihto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "informationsutbyte",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "information exchange",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Informaation vaihto toimenpiteet informaatiovaatimuksen tai sen osan täyttämiseksi.",
          "@language": "fi"
        },
        {
          "@value": "Åtgärder för att uppfylla ett informationskrav eller en del av det.",
          "@language": "sv"
        },
        {
          "@value": "Actions to fulfil an information requirement or part of it.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN/ISO 19650:2018",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/68078.html"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiovaatimus"
      ],
