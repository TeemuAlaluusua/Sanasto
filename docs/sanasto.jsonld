    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/koneluettavuus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "koneluettavuus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "maskinläsbarhet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "machine readability",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "tieto on rakenteistettu systemaattiseen muotoon siten, että kone pystyy tulkitsemaan, käsittelemään ja siirtämään sitä tietojenkäsittelyjärjestelmään ilman käyttäjän toimenpiteitä",
          "@language": "fi"
        },
        {
          "@value": "information är strukturerad i en systematisk form så att en maskin kan tolka, bearbeta och överföra den till ett informationssystem utan användarens åtgärder",
          "@language": "sv"
        },
        {
          "@value": "information is structured in a systematic form so that a machine can interpret, process and transfer it into an information system without user intervention",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Koneluettavia tekniikoita ovat esimerkiksi lineaariset (1D) viivakoodit,\nkaksiulotteiset symbolit, magneettijuovakortit, RFID, biometria ja\noptinen kirjaintunnistus.\n",
          "@language": "fi"
        },
        {
          "@value": "Maskinläsbara tekniker är till exempel linjära (1D) streckkoder,\ntvådimensionella symboler, magnetremskort, RFID, biometriska metoder\noch optisk teckenigenkänning.\n",
          "@language": "sv"
        },
        {
          "@value": "Machine-readable technologies include, for example, linear (1D) barcodes,\ntwo-dimensional symbols, magnetic stripe cards, RFID, biometrics and\noptical character recognition.\n",
          "@language": "en"
        },
        {
          "@value": "Tiedot esitetään tyypillisesti tietovirrassa ennalta määritellyissä\npaikoissa (kentissä), jolloin tietokoneohjelma voi tulkita ne.\n",
          "@language": "fi"
        },
        {
          "@value": "Uppgifterna presenteras vanligtvis i en dataström på fördefinierade\nplatser (fält), vilket gör att ett datorprogram kan tolka dem.\n",
          "@language": "sv"
        },
        {
          "@value": "Data is typically presented in a data stream in predefined positions\n(fields), enabling a computer program to interpret it.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 19762-1:2025",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/data"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/metatieto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tiedonhallinta",
        "https://teemualaluusua.github.io/sanasto1/#/concept/automatisoitu",
        "https://teemualaluusua.github.io/sanasto1/#/concept/digitointi",
        "https://teemualaluusua.github.io/sanasto1/#/concept/koneluettava"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/data-analyysi",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "data-analyysi",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "dataanalys",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data analysis",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Data-analyysillä tarkoitetaan datan elinkaaren vaihetta, joka käsittää tekniikat, joita käytetään analyytikon tavoitteiden saavuttamiseen eli informatiivisen tiedon tuottamiseen organisoidusta datasta.",
          "@language": "fi"
        },
        {
          "@value": "Med dataanalys avses ett skede i datans livscykel som omfattar de tekniker som används för att uppnå analytikerns mål, det vill säga för att producera informativ kunskap ur organiserad data.",
          "@language": "sv"
        },
        {
          "@value": "Data analysis refers to a stage in the data lifecycle comprising the techniques used to achieve the analyst's objectives, i.e. to produce informative knowledge from organized data.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2017",
          "@language": "fi",
          "@id": "https://www.iso.org"
        }
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/gtin-tunnus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "GTIN-tunnus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "kansainvälinen tuotenumero",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "GTIN",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "GTIN",
          "@language": "en",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Global Trade Item Number",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "standardi koodin ainutkertainen numero, jota käytetään kansainvälisesti tunnistamaan tuotteita ja pakkauksia",
          "@language": "fi"
        },
        {
          "@value": "ett unikt nummer i en standardiserad kod som används internationellt för att identifiera produkter och förpackningar",
          "@language": "sv"
        },
        {
          "@value": "a unique number in a standard code used internationally to identify products and packages",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "fi"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "skos:related": [
