    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tiedonsiirron-yhteentoimivuus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tiedonsiirron yhteentoimivuus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "transportinteroperabilitet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "transport interoperability",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tiedonsiirron yhteentoimivuudella tarkoitetaan yhteentoimivuutta, jossa osallisten järjestelmien välisessä tiedonsiirrossa käytetään sovittua viestintäinfrastruktuuria.",
          "@language": "fi"
        },
        {
          "@value": "Med transportinteroperabilitet avses interoperabilitet där dataöverföringen mellan de deltagande systemen sker via en överenskommen kommunikationsinfrastruktur.",
          "@language": "sv"
        },
        {
          "@value": "Transport interoperability refers to interoperability in which data transfer between the participating systems uses an agreed communication infrastructure.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 22123-1:2023",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/82758.html"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/yhteentoimivuus"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/pir",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "projektin informaatiovaatimukset",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "projektets informationskrav",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "project information requirements",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "PIR",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "PIR",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "PIR",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Informaatiovaatimukset, jotka kuvaavat mitä tietoa tarvitaan tukemaan projektin tavoitteisiin liittyvää päätöksentekoa projektin eri vaiheissa.",
          "@language": "fi"
        },
        {
          "@value": "Informationskrav som beskriver vilken information som behövs för att stödja beslutsfattande relaterat till projektets mål under projektets olika skeden.",
          "@language": "sv"
        },
        {
          "@value": "Information requirements describing what information is needed to support decision-making related to the project's objectives at each project stage.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "PIR johdetaan organisaation informaatiovaatimuksista (OIR) ja\nomaisuuskohteen informaatiovaatimuksista (AIR), ja se puolestaan\nohjaa vaihekohtaisten informaation vaihdon vaatimusten (EIR)\nmäärittelyä ISO 19650 -standardin mukaisessa mallissa.\n",
          "@language": "fi"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN ISO 19650-1:2018",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/68078.html"
        },
        {
          "@value": "Suomi.fi-sanasto EN 19650",
          "@language": "fi",
          "@id": "https://sanastot.suomi.fi/terminology/en19650/concept-21"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiovaatimus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/oir",
        "https://teemualaluusua.github.io/sanasto1/#/concept/air",
        "https://teemualaluusua.github.io/sanasto1/#/concept/eir"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tunnistus--ja-tiedonkeruutekniikat",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tunnistus- ja tiedonkeruutekniikat",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "identifierings- och datainsamlingstekniker",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "identification and data capture techniques",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tarkoittaa menetelmiä, joilla kohteet tunnistetaan automaattisesti, kerätään niitä koskevia tietoja ja syötetään nämä tiedot suoraan tietokonejärjestelmiin (eli ilman ihmisen osallistumista) - esimerkiksi viivakoodien, RFID:n jne. käyttö.",
          "@language": "fi"
        },
        {
          "@value": "Avser metoder med vilka objekt identifieras automatiskt, uppgifter om dem samlas in och dessa uppgifter matas in direkt i datorsystem (det vill säga utan mänsklig medverkan) - till exempel användning av streckkoder, RFID med mera.",
          "@language": "sv"
        },
        {
          "@value": "Refers to methods by which objects are automatically identified, data about them is collected, and this data is entered directly into computer systems (i.e. without human involvement) - for example, the use of barcodes, RFID, etc.",
          "@language": "en"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/viivakoodi",
        "https://teemualaluusua.github.io/sanasto1/#/concept/rfid"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/nimiavaruus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "nimiavaruus",
          "@language": "fi",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "namnrymd",
          "@language": "sv",
          "termType": "Synonyymi"
        },
        {
          "@value": "namespace",
          "@language": "en",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "nimeämiseen tietyssä asia- tai toimintayhteydessä käytettävissä olevien elementtien joukko",
          "@language": "fi"
        },
        {
          "@value": "mängd av element som används för namngivning inom ett visst sak- eller verksamhetssammanhang",
          "@language": "sv"
        },
        {
          "@value": "set of elements available for naming within a specific context or domain of activity",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Elementit voivat olla esimerkiksi nimiä, sanoja tai teknisiä termejä.",
          "@language": "fi"
        },
        {
          "@value": "Yhden nimiavaruuden sisällä yhdellä nimellä saa olla vain yksi merkitys, mutta eri nimiavaruuksissa samaa nimeä voi käyttää eri merkityksissä.",
          "@language": "fi"
        },
        {
          "@value": "Elementen kan till exempel vara namn, ord eller tekniska termer.",
          "@language": "sv"
        },
        {
          "@value": "Inom en och samma namnrymd får ett namn endast ha en betydelse, men i olika namnrymder kan samma namn användas med olika betydelser.",
          "@language": "sv"
        },
        {
          "@value": "Elements can be, for example, names, words or technical terms.",
          "@language": "en"
        },
        {
          "@value": "Within a single namespace, a name can have only one meaning, but in different namespaces the same name can be used with different meanings.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-30"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomääritys"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tunniste",
        "https://teemualaluusua.github.io/sanasto1/#/concept/uri",
        "https://teemualaluusua.github.io/sanasto1/#/concept/ontologia",
        "https://teemualaluusua.github.io/sanasto1/#/concept/skeema",
        "https://teemualaluusua.github.io/sanasto1/#/concept/iri"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/loin",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "informaatiotarve",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "informationsbehov",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Level of Information Need",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "LOIN",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "LOIN",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "LOIN",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Viitekehys (LOIN), joka määrittelee informaation laajuuden ja rakeisuuden.",
          "@language": "fi"
        },
        {
          "@value": "Ramverk (LOIN) som definierar informationens omfattning och detaljeringsgrad.",
          "@language": "sv"
        },
        {
          "@value": "Framework (LOIN) that defines the extent and granularity of information.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Informaatiotarpeen määrittelyn yksi tarkoitus on estää liiallisen informaation toimittaminen.\nRakennustietomallien osalta puhutaan usein kehitystasomäärittelystä (LOD), joka on suunniteltu erityisesti mallipohjaista työskentelyä varten.\nLOIN-termillä pyritään kuvaamaan koko projektin tietosisältöä laajemmin siirtämällä painopistettä metatietoon geometristen ominaisuuksien sijasta.\n",
          "@language": "fi"
        },
        {
          "@value": "Ett syfte med att definiera informationsbehov är att undvika att leverera för mycket information.\nInom byggnadsinformationsmodeller används ofta begreppet utvecklingsnivå (LOD), som är särskilt avsett för modellbaserat arbete.\nMed termen LOIN eftersträvas att beskriva projektets informationsinnehåll mer heltäckande med större fokus på metadata än på geometriska egenskaper.\n",
          "@language": "sv"
        },
        {
          "@value": "One purpose of defining information need is to avoid delivering excessive information.\nIn building information modelling, the concept of level of development (LOD) is often used and is intended for model-based workflows.\nThe term LOIN aims to describe the overall information content of a project more broadly by emphasizing metadata over geometric properties.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN/ISO 19650:2018",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/68078.html"
        },
        {
          "@value": "Tomczak 2022",
          "@language": "fi",
          "@id": "https://www.buildingsmart.org/methods-to-specify-information-requirements-in-digital-construction-projects/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/lod"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-19T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/sparql",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "SPARQL protocol and RDF query language",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "SPARQL protocol and RDF query language",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "SPARQL protocol and RDF query language",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "SPARQL",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "SPARQL",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "SPARQL",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "W3C:n standardoima kyselykieli ja protokolla, jolla haetaan ja\nmuokataan RDF-muodossa esitettyä tietoa.\n",
          "@language": "fi"
        },
        {
          "@value": "Ett W3C-standardiserat frågespråk och protokoll för att hämta och\nbearbeta data som representeras i RDF-format.\n",
          "@language": "sv"
        },
        {
          "@value": "A W3C-standardized query language and protocol for retrieving and\nmanipulating data represented in RDF format.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "SPARQL vastaa RDF-tietokantojen kyselykielenä samaa tarkoitusta\nkuin SQL relaatiotietokannoissa.\n",
          "@language": "fi"
        }
      ],
      "dcterms:source": [
        {
          "@value": "SPARQL 1.1 Query Language",
          "@id": "https://www.w3.org/TR/sparql11-query/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rdf",
        "https://teemualaluusua.github.io/sanasto1/#/concept/owl",
        "https://teemualaluusua.github.io/sanasto1/#/concept/semanttinen-web",
        "https://teemualaluusua.github.io/sanasto1/#/concept/rdf-kolmikko"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/entiteetti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "entiteetti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "entitet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "entity",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "jokin, joka voidaan tunnistaa yksikäsitteisesti",
          "@language": "fi"
        },
        {
          "@value": "något som kan identifieras entydigt",
          "@language": "sv"
        },
        {
          "@value": "something capable of being uniquely identified",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Entiteetit käsittävät aineelliset objektit, digitaaliset dokumentit,\nabstraktit kohteet (kuten ajat ja paikat), toimijat (luonnolliset ja\njuridiset henkilöt) sekä kaiken muun, mikä voidaan identifioida.\n",
          "@language": "fi"
        },
        {
          "@value": "Entiteter omfattar materiella objekt, digitala dokument,\nabstrakta företeelser (såsom tider och platser), aktörer\n(naturliga och juridiska personer) samt allt annat som kan\nidentifieras entydigt.\n",
          "@language": "sv"
        },
        {
          "@value": "Entities include material objects, electronic representations\nof content, abstract items (such as times and places), parties\n(human and corporate), as well as anything else that can be\nuniquely identified.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/luokka"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/käänteinen-logistiikka",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "käänteinen logistiikka",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "omvänd logistik",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "reverse logistics",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Käänteisellä logistiikalla tarkoitetaan tuotteiden liikkumista kulutuspisteistä kohti lähtöpisteitä. Käänteisen logistiikan viitataan usein kierrätykseen ja vastuulliseen jätehuoltoon. Sen voidaan kuitenkin katsoa liittyvän tuotantoprosessissa syntyneiden tuotteiden palauttamiseen (mm. asennusten ylijäämämateriaali sekä vialliset tai väärät tuotteet), uusiokäyttöön tai kierrättämiseen alkuperäisestä kulutuspisteestä takaisin tuotantoketjuun, sisältäen myös tuotteiden elinkaaren aikaiset huolto, korjaus ja kunnostustoimenpiteet sekä asianmukaisen hävittämisen.",
          "@language": "fi"
        },
        {
          "@value": "Med omvänd logistik avses produkters förflyttning från konsumtionsställen mot ursprungsställen. Omvänd logistik hänvisar ofta till återvinning och ansvarsfull avfallshantering. Den kan dock även anses omfatta returnering av produkter som uppstått i produktionsprocessen (bland annat överskottsmaterial från installationer samt felaktiga eller fel produkter), återanvändning eller återvinning från det ursprungliga konsumtionsstället tillbaka till produktionskedjan, inklusive service-, reparations- och renoveringsåtgärder under produkternas livscykel samt ändamålsenlig kassering.",
          "@language": "sv"
        },
        {
          "@value": "Reverse logistics refers to the movement of products from points of consumption back towards points of origin. Reverse logistics is often associated with recycling and responsible waste management. However, it can also be seen as covering the return of products generated during the production process (including surplus installation material and defective or incorrect products), their reuse or recycling from the original point of consumption back into the production chain, including maintenance, repair and refurbishment activities throughout the products' lifecycle, as well as proper disposal.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Alaluusua, 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/logistiikka"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rest-ohjelmistorajapinta",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "REST-ohjelmistorajapinta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "REST",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "representational state transfer application programming interface; REST API",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "REST on ohjelmointirajapintojen toteuttamiseen tarkoitettu arkkitehtuurimalli (tai tyyli), jota käytetään hajautettujen järjestelmien väliseen kommunikaatioon. REST-malli määrittelee sovellukset tietoa käsittelevien osien (komponentit), tietokohteiden (resurssit), sekä näiden yhteyksien kautta.",
          "@language": "fi"
        },
        {
          "@value": "REST är en arkitekturmodell (eller stil) avsedd för att implementera programmeringsgränssnitt, som används för kommunikation mellan distribuerade system. REST-modellen definierar applikationer med hjälp av databehandlande delar (komponenter), dataobjekt (resurser) samt förbindelserna mellan dessa.",
          "@language": "sv"
        },
        {
          "@value": "REST is an architectural model (or style) intended for implementing programming interfaces, used for communication between distributed systems. The REST model defines applications through data-processing parts (components), data objects (resources), and the connections between them.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/ohjelmointirajapinta"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/gsin",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "logistisen toimituksen tunniste",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "globalt sändningsidentifieringsnummer",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Global Shipment Identification Number",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "GSIN",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "GSIN",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "GSIN",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "GSIN on GS1:n yksilöinnin standardi, jota käytetään tunnistamaan samaan toimitukseen kuuluvat logistiset yksiköt. Logististen yksiköiden muodostama toimitus dokumentoidaan samalle lähetysasiakirjalle ja/tai konossementille saman GSIN-tunnuksen alle. GSIN-tunnisteen avulla logistiset yksiköt voidaan seurata ja jäljittää kuljetusketjussa rahdinlähettäjältä vastaanottajalle, ja ketjun osapuolet voivat hyödyntää samaa tunnistetta esim. kuljetuksen ohjeistuksen tai tilanteen viestimisessä. Tunnistetta voidaan käyttää myös EDI-sanomissa toimituksen viitenumerona.",
          "@language": "fi"
        },
        {
          "@value": "GSIN är en GS1-identifieringsstandard som används för att identifiera de logistiska enheter som hör till samma sändning. En sändning som bildas av logistiska enheter dokumenteras på samma fraktsedel och/eller konossement under samma GSIN-identifierare. Med hjälp av GSIN kan logistiska enheter spåras genom hela transportkedjan, från avsändare till mottagare, och parterna i kedjan kan använda samma identifierare för att t.ex. förmedla transportinstruktioner eller statusinformation. Identifieraren kan även användas som sändningens referensnummer i EDI-meddelanden.",
          "@language": "sv"
        },
        {
          "@value": "GSIN is a GS1 identification standard used to identify the logistics units belonging to the same shipment. A shipment formed of logistics units is documented on the same consignment note and/or bill of lading under the same GSIN identifier. GSIN makes it possible to track and trace logistics units throughout the transport chain, from consignor to consignee, and parties in the chain can use the same identifier to, for example, convey transport instructions or status information. The identifier can also be used as a shipment reference number in EDI messages.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "GS1 yksilöinti standardit",
          "@language": "fi",
          "@id": "https://www.gs1.org/standards/id-keys"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/kardinaliteetti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "kardinaliteetti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "kardinalitet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "cardinality",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tietomallissa kahden tietoelementin välisen suhteen sallittu tai vaadittu lukumäärä.",
          "@language": "fi"
        },
        {
          "@value": "Det tillåtna eller obligatoriska antalet i förhållandet mellan två datalement i en datamodell.",
          "@language": "sv"
        },
        {
          "@value": "The permitted or required number of occurrences in the relationship between two data elements in a data model.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Kardinaliteetti (minimi..maksimi) ilmaistaan usein merkinnöillä, kuten (1), (0..1), (1..n) tai (0..n).\n\n- (1) = täsmälleen yksi\n- (0..1) = nolla tai yksi (enintään yksi)\n- (1..n) = yksi tai useampi (vähintään yksi)\n- (0..n) = nolla tai useampia\n\nMerkintätavoissa käytetään myös symboleja kuten * tai jätetään maksimi auki (esim. 0..* / 0..n).\n",
          "@language": "fi"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RYHTI, Sanasto",
          "@language": "fi",
          "@id": "https://ryhti.syke.fi/ohjeet-ja-tuki/ryhti-sanasto/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tietomallinnus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
