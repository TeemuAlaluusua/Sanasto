    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rakenteellinen-aineisto-strukturoitu-data",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "rakenteellinen aineisto / strukturoitu data",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "strukturerad data",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "structured data",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Strukturoitu data tarkoittaa tietoa, joka on järjestetty määrättyyn muotoon tai skeemaan, tyypillisesti riveihin ja sarakkeisiin, kuten relaatiotietokannoissa tai taulukkolaskentaohjelmissa. Nämä tiedot noudattavat ennalta määriteltyä mallia, jossa on selkeät säännöt siitä, miten yksittäiset tiedot tallennetaan ja miten ne liittyvät toisiinsa. Strukturoitu tieto on hyvin järjestettyä ja sitä on helppo hakea, käyttää ja käsitellä tietokannan hallintajärjestelmien ja muiden työkalujen avulla. Esimerkkejä strukturoidusta datasta ovat tietokannat, taulukkolaskentaohjelmat ja tietyllä tavalla muotoillut tiedostot kuten XML ja JSON.",
          "@language": "fi"
        },
        {
          "@value": "Strukturerad data avser information som är organiserad enligt ett bestämt format eller schema, vanligtvis i rader och kolumner, som i relationsdatabaser eller kalkylprogram. Denna information följer en fördefinierad modell med tydliga regler för hur enskilda uppgifter lagras och hur de förhåller sig till varandra. Strukturerad information är väl organiserad och lätt att söka, använda och bearbeta med hjälp av databashanteringssystem och andra verktyg. Exempel på strukturerad data är databaser, kalkylprogram och filer formaterade på ett visst sätt, såsom XML och JSON.",
          "@language": "sv"
        },
        {
          "@value": "Structured data refers to information organized according to a defined format or schema, typically in rows and columns, as in relational databases or spreadsheets. This data follows a predefined model with clear rules on how individual items are stored and how they relate to one another. Structured data is well organized and easy to search, use and process with the help of database management systems and other tools. Examples of structured data include databases, spreadsheets and files formatted in a certain way, such as XML and JSON.",
          "@language": "en"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakenteeton-aineisto--strukturoimaton-data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/xml",
        "https://teemualaluusua.github.io/sanasto1/#/concept/json"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/dataformaatti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "dataformaatti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "dataformat",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data format",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "datan ennalta määritelty järjestys tallennusmedialla",
          "@language": "fi"
        },
        {
          "@value": "förutbestämd ordning av data på ett datamedium",
          "@language": "sv"
        },
        {
          "@value": "predetermined arrangement of data on a data medium",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Dataformaatti määrittelee, miten data esitetään ja\njäsennetään tallennuksessa tai tiedonsiirrossa.\n",
          "@language": "fi"
        },
        {
          "@value": "Dataformat anger hur data representeras och struktureras\nvid lagring eller överföring.\n",
          "@language": "sv"
        },
        {
          "@value": "A data format specifies how data is represented and\nstructured for storage or transmission.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/esitysformaatti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/säilytysformaatti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/vaihtoformaatti"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/big-data",
        "https://teemualaluusua.github.io/sanasto1/#/concept/formaatti"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    }
  ]
