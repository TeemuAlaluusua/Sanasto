    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/property-set",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "ominaisuusjoukko",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "egenskapsuppsättning",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "property set",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "Pset",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "joukko ominaisuuksia, jotka liitetään tiettyyn objektiin tai objektityyppiin",
          "@language": "fi"
        },
        {
          "@value": "uppsättning egenskaper som kopplas till ett visst objekt eller en objekttyp",
          "@language": "sv"
        },
        {
          "@value": "set of properties assigned to a specific object or object type",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Ominaisuusjoukko voi olla standardoitu tai projektikohtaisesti määritelty.",
          "@language": "fi"
        },
        {
          "@value": "Egenskapsuppsättningen kan vara standardiserad eller projektspecifik.",
          "@language": "sv"
        },
        {
          "@value": "A property set can be standardized or defined for a specific project.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "buildingSMART Terminology",
          "@language": "en",
          "@id": "https://user.buildingsmart.org/knowledge-base/terminology/"
        }
      ],
