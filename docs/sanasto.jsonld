        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/mes",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tuotannonohjausjärjestelmä",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "produktionsstyrningssystem",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "manufacturing execution system",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "MES",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "MES",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "MES",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "järjestelmä haluttujen tuotteiden tai palvelujen tuottamiseen, mukaan lukien laadunvalvonta, dokumenttien hallinta, tuotannonohjaus, keskeneräisen tuotannon seuranta, yksityiskohtainen tuotteen reititys ja seuranta, työraportointi, resurssien ja uudelleentyöstön hallinta, tuotannon mittaus ja tiedonkeruu",
          "@language": "fi"
        },
        {
          "@value": "system för att producera önskade produkter eller tjänster, inklusive kvalitetskontroll, dokumenthantering, produktionsstyrning, uppföljning av arbete under produktion, detaljerad produktdirigering och spårning, arbetsrapportering, hantering av resurser och omarbete samt produktionsmätning och datainsamling",
          "@language": "sv"
        },
        {
          "@value": "system for producing the desired products or services, including quality control, document management, plant floor dispatching, work-in-process tracking, detailed product routing and tracking, labour reporting, resource and rework management, production measurement and data collection",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 16100-1:2009, 3.14",
          "@language": "en",
          "@id": "https://www.iso.org/"
        },
        {
          "@value": "ISO/TR 3151-1:2023,3.1.7",
          "@language": "en",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/erp",
        "https://teemualaluusua.github.io/sanasto1/#/concept/plm",
        "https://teemualaluusua.github.io/sanasto1/#/concept/mom"
      ],
      "dcterms:created": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
