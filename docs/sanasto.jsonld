    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/koodisto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "koodisto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "kodlista",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "codelist",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "kokoelma tiettyä käyttötarkoitusta varten määriteltyjä koodeja tai luettelo luokan ominaisuuden sallituista arvoista",
          "@language": "fi"
        },
        {
          "@value": "Value domain including a code for each permissible value / Complete set of data element values of a coded simple data element",
          "@language": "en"
        },
        {
          "@value": "värdemängd som innehåller en kod för varje tillåtet värde / fullständig uppsättning värden för ett kodat dataelement",
          "@language": "sv"
        }
      ],
      "skos:note": [
        {
          "@value": "Koodisto määrittelee sallitut arvot tietylle tietoelementille ja toimii\ntiedon validoinnin ja yhdenmukaisuuden varmistamisen välineenä.\n",
          "@language": "fi"
        },
        {
          "@value": "En kodlista definierar tillåtna värden för ett visst dataelement och fungerar\nsom ett medel för att säkerställa datavalidering och enhetlighet.\n",
          "@language": "sv"
        },
        {
          "@value": "A codelist defines the permissible values for a specific data element and\nserves as a means to ensure data validation and consistency.\n",
          "@language": "en"
        },
        {
          "@value": "Koodistoja käytetään erityisesti tietomalleissa ja rajapinnoissa, joissa\ntietosisältö esitetään ennalta määriteltyjen arvojen avulla.\n",
          "@language": "fi"
        },
        {
          "@value": "Kodlistor används särskilt i datamodeller och gränssnitt där informationsinnehåll\nrepresenteras med hjälp av fördefinierade värden.\n",
          "@language": "sv"
        },
        {
          "@value": "Codelists are particularly used in data models and interfaces where\ninformation content is represented using predefined values.\n",
          "@language": "en"
        },
        {
          "@value": "Koodisto eroaa luokituksesta siten, että koodisto määrittelee sallitut arvot,\nkun taas luokitus kuvaa käsitteellistä ryhmittelyä.\n",
          "@language": "fi"
        },
        {
          "@value": "En kodlista skiljer sig från en klassificering genom att den definierar\ntillåtna värden, medan en klassificering beskriver en begreppsmässig\nindelning.\n",
          "@language": "sv"
        },
        {
          "@value": "A codelist differs from a classification in that it defines permissible\nvalues, whereas a classification describes a conceptual grouping.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-11"
        },
        {
          "@value": "ISO 19136",
          "@language": "en",
          "@id": "https://www.iso.org/"
        },
        {
          "@value": "ISO 9735-1:2002",
          "@language": "en",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomääritys"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/luokitus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/sanasto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/metatieto",
        "https://teemualaluusua.github.io/sanasto1/#/concept/versio"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/alfanumeerinen",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "alfanumeerinen",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "alfanumerisk",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "alphanumeric",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "aakkosnumeerinen",
          "@language": "fi",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Aakkosista (A–Z) ja numeroista (0–9) koostuva tai niitä sisältävä merkistö, koodi tai tieto. Vastakohtana pelkästään aakkosellinen tai pelkästään numeerinen.\n",
          "@language": "fi"
        }
      ],
      "skos:note": [
        {
          "@value": "Alfanumeerinen ei sisällä välimerkkejä tai erikoismerkkejä; jos myös niitä sallitaan, puhutaan esimerkiksi alfanumeerisesta ja erikoismerkkejä sisältävästä merkkijonosta tai laajennetusta merkistöstä.",
          "@language": "fi"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 19762:2025. Information technology — Automatic identification and data capture techniques — Harmonized vocabulary"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/alfanumeerinen-koodi"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-26T10:33:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/idm",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tiedon toimitusohje",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "informationsleveransmanual",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "information delivery manual",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "IDM",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "IDM",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "IDM",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "SFS-EN ISO 29481-1 -standardin mukainen menettely, jolla kuvataan informaatiotuotannon prosessit ja sisältövaatimukset tiettyyn käyttötarkoitukseen tuotettavalle informaatiolle",
          "@language": "fi"
        },
        {
          "@value": "metod enligt SFS-EN ISO 29481-1 för att beskriva processer för informationsproduktion och innehållskrav för information som tas fram för ett visst användningsändamål",
          "@language": "sv"
        },
        {
          "@value": "method according to SFS-EN ISO 29481-1 for describing information production processes and content requirements for information produced for a specific purpose",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "IDM-määrittely jakautuu kolmeen osioon: käyttötapaus, prosessit ja\ntiedonvaihdon vaatimukset (Use Case, Process Definition, Exchange Requirement).\n",
          "@language": "fi"
        },
        {
          "@value": "IDM-definitionen delas in i tre delar: användningsfall, processer och\nkrav på informationsutbyte (Use Case, Process Definition, Exchange Requirement).\n",
          "@language": "sv"
        },
        {
          "@value": "IDM is divided into three parts: use case, process definition and\nexchange requirements.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Ympäristöministeriö – Yleiset tietomallivaatimukset 2022",
          "@language": "fi",
          "@id": "https://rastiprojekti.com/wp-content/uploads/2019/02/RASTI-strategia-v1.pdf"
        },
        {
          "@value": "SFS-EN ISO 29481-1",
          "@language": "en",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/eir",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli"
      ],
      "dcterms:created": {
