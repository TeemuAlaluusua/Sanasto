      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rakennus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "rakennus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "byggnad",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "building",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "paikallaan pysyväksi tarkoitettu, omalla sisäänkäynnillä varustettu, katettu ja ulkoseinien rajaama rakennuskohde",
          "@language": "fi"
        },
        {
          "@value": "byggnadsobjekt som är avsett att stå permanent på platsen, försett med egen ingång, täckt och avgränsat av ytterväggar",
          "@language": "sv"
        },
        {
          "@value": "built asset intended to remain in place, provided with its own entrance, covered and enclosed by external walls",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Toisistaan erillään olevat rakennukset ovat aina itsenäisiä rakennuksia. Kaikki itsenäiset rakennukset eivät kuitenkaan ole erillään muista rakennuksista esimerkiksi kadun varteen rakennettaessa. Esimerkiksi rivitalot, paritalot ja kerrostalot ovat itsenäisiä rakennuksia.",
          "@language": "fi"
        },
        {
          "@value": "Rakennus on fyysinen kokonaisuus. Rakennusta koskevaa tietoa voidaan esittää rakennuskohdetietueessa.",
          "@language": "fi"
        },
        {
          "@value": "Rakennuksen olosuhteiden ja mitoituksen tulisi pääasiallisesti mahdollistaa ihmisten toiminta ainakin osassa rakennuksen tiloista.",
          "@language": "fi"
        },
        {
          "@value": "Käsitejärjestelmäkaavio: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "fi"
        },
        {
          "@value": "Rakennuksen ulkovaipan sisäpuolella on sisätiloja. Rakennuksen ulkovaipan rajapintaan rajautuu välittömästi rakennuksen yhteydessä olevia ja rakennukseen kuuluvia ulkotiloja, kuten parvekkeet, terassit, katokset, lavat jne.",
          "@language": "fi"
        },
        {
          "@value": "Sisäänkäynnillä tarkoitetaan ovea tai aukkoa, josta on kulku rakennukseen sen ulkopuolelta.",
          "@language": "fi"
        },
        {
          "@value": "Byggnader som är åtskilda från varandra är alltid självständiga byggnader. Alla självständiga byggnader är dock inte nödvändigtvis separerade från andra byggnader, till exempel vid byggande längs en gata. Till exempel radhus, parhus och höghus är självständiga byggnader.",
          "@language": "sv"
        },
        {
          "@value": "En byggnad är en fysisk helhet. Information om byggnaden kan presenteras i en byggnadsobjektpost.",
          "@language": "sv"
        },
        {
          "@value": "Byggnadens förhållanden och dimensionering bör huvudsakligen möjliggöra mänsklig verksamhet åtminstone i en del av byggnadens utrymmen.",
          "@language": "sv"
        },
        {
          "@value": "Innanför byggnadens ytterhölje finns inomhusutrymmen. Vid ytterhöljets gräns finns omedelbart utomhusutrymmen som hör till byggnaden och är i direkt anslutning till den, såsom balkonger, terrasser, skärmtak, plattformar osv.",
          "@language": "sv"
        },
        {
          "@value": "Med ingång avses en dörr eller öppning genom vilken man kan komma in i byggnaden utifrån.",
          "@language": "sv"
        },
        {
          "@value": "Buildings that are separate from each other are always independent buildings. However, not all independent buildings are physically separated from others, for example when built along a street. Row houses, semi-detached houses and apartment buildings are examples of independent buildings.",
          "@language": "en"
        },
        {
          "@value": "A building is a physical entity. Information concerning a building can be represented in a built asset record.",
          "@language": "en"
        },
        {
          "@value": "The conditions and dimensions of a building should primarily enable human activity at least in part of the building’s spaces.",
          "@language": "en"
        },
        {
          "@value": "Inside the building envelope there are interior spaces. At the boundary of the building envelope there are outdoor spaces directly associated with the building, such as balconies, terraces, canopies, platforms etc.",
          "@language": "en"
        },
        {
          "@value": "An entrance means a door or opening that provides access to the building from outside.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RY-mallit sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rymallit/c27"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohde"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/digitaalinen-kaksonen"
      ],
      "dcterms:created": {
        "@value": "2025-12-23T14:08",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-16T14:08",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/formaatti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "formaatti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "dataformat",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data format",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "datan esitysmuoto jonkin määritellyn enkoodaustavan mukaisesti",
          "@language": "fi"
        },
        {
          "@value": "datas representationsform enligt en definierad kodningsmetod",
          "@language": "sv"
        },
        {
          "@value": "representation of data according to a defined encoding method",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Helsingin yliopisto:2024",
          "@language": "fi",
          "@id": "https://wiki.helsinki.fi/xwiki/bin/view/stemmatology/Data%20formats/"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomääritys"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/dataformaatti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/vaihtoformaatti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/säilytysformaatti"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-17T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/standardi",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "standardi",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "standard",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "standard",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Standardi on tekninen dokumentti, jota on tarkoitus käyttää sääntönä, ohjeena tai määritelmänä. Standardi laaditaan kaikille ymmärrettävässä muodossa ja se on mahdollista ottaa käyttöön dokumentin pohjalta.",
          "@language": "fi"
        },
        {
          "@value": "En standard är ett tekniskt dokument avsett att användas som regel, anvisning eller definition. En standard utarbetas i en form som är begriplig för alla, och det är möjligt att ta den i bruk utifrån dokumentet.",
          "@language": "sv"
        },
        {
          "@value": "A standard is a technical document intended to be used as a rule, guideline or definition. A standard is drawn up in a form that is understandable to everyone, and it can be put into use on the basis of the document.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastot",
          "@language": "fi",
          "@id": "https://sanastot.suomi.fi/"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/etim-standardi",
        "https://teemualaluusua.github.io/sanasto1/#/concept/de-facto-standardi",
        "https://teemualaluusua.github.io/sanasto1/#/concept/sql-kieli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/standardointi"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/toteutusmalli--tuotantomalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "toteutusmalli / tuotantomalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "genomförandemodell / produktionsmodell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "as-planned model",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Toteutusmalli on rakennustietomallin tietosisällön vaihe, joka pitää sisällään kaikki suunnitelman mukaiset tiedot, kuten rakennuksen mitat, materiaalit, rakenteet ja järjestelmät.",
          "@language": "fi"
        },
        {
          "@value": "Genomförandemodellen är ett skede i byggnadsinformationsmodellens datainnehåll som omfattar alla uppgifter enligt planen, såsom byggnadens mått, material, konstruktioner och system.",
          "@language": "sv"
        },
        {
          "@value": "The as-planned model is a stage in the data content of a building information model that contains all the information according to the plan, such as the building's dimensions, materials, structures and systems.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Ympäristöministeriö, RASTI-projekti: 2019",
          "@language": "fi",
          "@id": "https://rastiprojekti.com/wp-content/uploads/2019/02/RASTI-strategia-v1.pdf"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-tietomalli"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/vakiotuote",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "vakiotuote",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "standardprodukt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "standard product",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Vakiotuotteella tarkoitetaan valmistajan yleisesti saatavilla olevan tuotevalikoiman tuotteita, jotka on suunniteltu yleisiin tarpeisiin ja valmistettu ennalta määritettyjen ominaisuuksien, mittojen ja standardien mukaisesti. Vakiotuotteina on pidetty MTS-tuotantostrategian mukaisia standardoituja vakiokauppatuotteita, sekä MTO-tuotantostrategian mukaisia tilaustuotteita.",
          "@language": "fi"
        },
        {
          "@value": "Med standardprodukt avses produkter i tillverkarens allmänt tillgängliga produktsortiment, vilka är utformade för allmänna behov och tillverkade enligt på förhand fastställda egenskaper, mått och standarder. Standardprodukter har ansetts vara standardiserade handelsprodukter enligt MTS-produktionsstrategin (make-to-stock) samt beställningsprodukter enligt MTO-produktionsstrategin (make-to-order).",
          "@language": "sv"
        },
        {
          "@value": "A standard product refers to products in the manufacturer's generally available product range, designed for general needs and manufactured according to predefined properties, dimensions and standards. Standard products have been regarded as standardized trade products under the make-to-stock (MTS) production strategy, as well as order products under the make-to-order (MTO) production strategy.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Alaluusua 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        },
        {
          "@value": "ISO 15489-1:2017",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/73292.html"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/projektituote",
        "https://teemualaluusua.github.io/sanasto1/#/concept/mts",
        "https://teemualaluusua.github.io/sanasto1/#/concept/mto"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/air",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "omaisuuskohteen informaatiovaatimukset",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "informationskrav för tillgång",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "asset information requirements",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "AIR",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "AIR",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "AIR",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Omaisuuskohteen informaatiovaatimukset kuvaavat informaatiovaatimukset suhteessa omaisuuskohteen käyttöön. Omaisuuskohteen informaatiovaatimuksissa (AIR) esitetään omaisuuskohteen informaation tuottamiseen tarvittavat liikkeenjohdolliset, kaupalliset ja tekniset näkökohdat.",
          "@language": "fi"
        },
        {
          "@value": "Informationskrav för en tillgång beskriver informationskraven i förhållande till användningen av tillgången. I tillgångens informationskrav (AIR) anges de ledningsmässiga, kommersiella och tekniska aspekter som behövs för att producera information om tillgången.",
          "@language": "sv"
        },
        {
          "@value": "Asset information requirements describe the information requirements in relation to the use of an asset. The asset information requirements (AIR) present the managerial, commercial and technical aspects required to produce information about the asset.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN/ISO 19650:2018",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/68078.html"
        },
        {
          "@value": "Suomi.fi-sanasto EN 19650",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/en19650/concept-20"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiovaatimus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/oir",
        "https://teemualaluusua.github.io/sanasto1/#/concept/pir"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/vaihtoformaatti",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "vaihtoformaatti",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "utbytesformat",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "exchange format",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "koneluettava dataformaatti, jonka avulla tieto esitetään sellaisessa muodossa, jossa sitä voidaan vaihtaa eri sovellusten välillä",
          "@language": "fi"
        },
        {
          "@value": "maskinläsbart dataformat som används för att representera information i en form som möjliggör utbyte mellan olika applikationer",
          "@language": "sv"
        },
        {
          "@value": "machine-readable data format for representing information that is intended to facilitate exchange of the information between different applications",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Vaihtoformaatteja käytetään tietojen siirtämiseen\neri tietojärjestelmien tai ohjelmistojen välillä\nyhteentoimivuuden varmistamiseksi.\n",
          "@language": "fi"
        },
        {
          "@value": "Utbytesformat används för att överföra information\nmellan olika informationssystem eller programvara\nför att möjliggöra interoperabilitet.\n",
          "@language": "sv"
        },
        {
          "@value": "Exchange formats are used to transfer information\nbetween different information systems or software\napplications to enable interoperability.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en",
          "@id": "https://www.iso.org/standard/59743.html"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/dataformaatti"
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/ubl"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/säilytysformaatti",
        "https://teemualaluusua.github.io/sanasto1/#/concept/formaatti"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/yhteentoimivuus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "yhteentoimivuus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "interoperabilitet",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "interoperability",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "toimintaan liittyvien toimijoiden, prosessien ja tietojärjestelmien kyky toimia ja viestiä keskenään sellaisella tavalla tai siinä laajuudessa, että ne voivat rutiininomaisesti käyttää ja ymmärtää toistensa tietoja",
          "@language": "fi"
        },
        {
          "@value": "förmåga hos aktörer, processer och informationssystem som är kopplade till en verksamhet att fungera och kommunicera med varandra på ett sådant sätt eller i sådan omfattning att de rutinmässigt kan använda och förstå varandras information",
          "@language": "sv"
        },
        {
          "@value": "ability of actors, processes and information systems that are connected to an activity to act and communicate together in such a way or scope that they can routinely use and understand each other's data",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Yhteentoimivuus voi olla luonteeltaan teknistä, semanttista, organisatorista tai oikeudellista.",
          "@language": "fi"
        },
        {
          "@value": "Interoperabilitet kan vara teknisk, semantisk, organisatorisk eller juridisk till sin natur.",
          "@language": "sv"
        },
        {
          "@value": "Interoperability can be technical, semantic, organisational or legal in nature.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Yhteentoimivuusalustan sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yti/concept-9"
        },
        {
          "@value": "ISO/IEC 22123-1:2023",
          "@language": "en",
          "@id": "https://www.iso.org/standard/82758.html"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/oikeudellinen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/organisatorinen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/semanttinen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/syntaktinen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tekninen-yhteentoimivuus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tiedonsiirron-yhteentoimivuus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/yhteentoimivuusalusta"
      ],
