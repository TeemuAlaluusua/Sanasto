    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rdf-kolmikko",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "RDF-kolmikko",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "RDF-trippel",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "RDF triple",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "RDF:ssä käytetty lauseen esitystapa, joka koostuu\nsubjektista, predikaatista ja objektista.\n",
          "@language": "fi"
        },
        {
          "@value": "Representation av ett påstående i RDF som består\nav subjekt, predikat och objekt.\n",
          "@language": "sv"
        },
        {
          "@value": "Representation of a statement in RDF consisting\nof a subject, predicate and object.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "RDF-kolmikko muodostaa RDF-tiedon perusrakenteen.\nSubjekti ja objekti kuvaavat resursseja ja\npredikaatti niiden välistä suhdetta.\n",
          "@language": "fi"
        },
        {
          "@value": "En RDF-trippel utgör den grundläggande strukturen\nför RDF-data. Subjekt och objekt representerar\nresurser och predikat beskriver relationen mellan dem.\n",
          "@language": "sv"
        },
        {
          "@value": "An RDF triple is the fundamental structure of RDF\ndata. The subject and object denote resources,\nwhile the predicate expresses the relationship\nbetween them.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en",
          "@id": "https://www.iso.org"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rdf"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/ontologia",
        "https://teemualaluusua.github.io/sanasto1/#/concept/semanttinen-web",
        "https://teemualaluusua.github.io/sanasto1/#/concept/sparql"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/gmn",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tuotemallin tunniste",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "globalt modellnummer",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Global Model Number",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "GMN",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "GMN",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "GMN",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "GMN on GS1:n yksilöinnin standardi, jonka käyttökohteena on laskentaryhmän, tuotetyyppien tai tuotteen mallin yksilöinti.",
          "@language": "fi"
        },
        {
          "@value": "GMN är en GS1-identifieringsstandard som används för att identifiera en produktmodell, en produkttyp eller en grupp av handelsvaror.",
          "@language": "sv"
        },
        {
          "@value": "GMN is a GS1 identification standard used to identify a product model, a product type, or a group of trade items.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "GS1 yksilöinti standardit",
          "@language": "fi",
          "@id": "https://www.gs1.org/standards/id-keys"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/grai",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "kiertävän kuormankantajan tunniste",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "global identifierare för returtillgångar",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Global Returnable Asset Identifier",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "GRAI",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "GRAI",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "GRAI",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "GRAI on GS1:n yksilöinnin standardi kiertävien kuormankantajien (palautettavat kuormalavat, laatikot, rullakot yms.) yksilöintiin.",
          "@language": "fi"
        },
        {
          "@value": "GRAI är en GS1-identifieringsstandard för identifiering av returlastbärare i omlopp (returpallar, backar, rullburar med mera).",
          "@language": "sv"
        },
        {
          "@value": "GRAI is a GS1 identification standard for identifying returnable transport items in circulation (returnable pallets, crates, roll cages, etc.).",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "GS1 yksilöinti standardit",
          "@language": "fi",
          "@id": "https://www.gs1.org/standards/id-keys"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "dcterms:created": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/arvoketju",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "arvoketju",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "arvoverkko",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "värdekedja",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "värdenätverk",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "value chain",
          "@language": "en",
          "termType": "Suositettava termi"
        },
        {
          "@value": "value network",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Toimintojen ja toimijoiden muodostama kokonaisuus,\njossa tuotteen tai palvelun arvo kasvaa vaiheittain.\n",
          "@language": "fi"
        },
        {
          "@value": "Helhet av aktiviteter eller aktörer som skapar eller mottar värde i form\nav produkter eller tjänster.\n",
          "@language": "sv"
        },
        {
          "@value": "Range of activities or parties that create or receive value in the form of products or services.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Arvoverkosto tarkoittaa toimijoiden välisten suhteiden muodostamaa kokonaisuutta, jossa arvo syntyy useiden toimijoiden välisestä vuorovaikutuksesta ja vaihdannasta. Arvoverkostossa organisaatiot, ryhmät tai yksilöt tuottavat toisilleen sekä aineellista arvoa (esim. tuotteet, palvelut, raha) että aineetonta arvoa (esim. tieto, osaaminen, luottamus ja yhteistyö).\nToisin kuin arvoketju, arvoverkosto ei ole lineaarinen prosessi, vaan monisuuntainen ja dynaaminen verkosto, jossa toimijat ovat keskenään yhteydessä useilla eri tavoilla. Arvo syntyy toimijoiden välisissä suhteissa, yhteistyössä ja tiedonvaihdossa. Arvoverkosto voi muodostua esimerkiksi yritysten, julkisen sektorin toimijoiden, järjestöjen ja yksilöiden välisestä yhteistyöstä.\n",
          "@language": "fi"
        },
        {
          "@value": "Ett värdenätverk avser en helhet av relationer mellan aktörer där värde uppstår genom interaktion och utbyte mellan flera deltagare. I ett värdenätverk skapar organisationer, grupper eller individer både materiellt värde (t.ex. produkter, tjänster, pengar) och immateriellt värde (t.ex. information, kunskap, förtroende och samarbete) för varandra.\nTill skillnad från en värdekedja är ett värdenätverk inte en linjär process utan ett mångriktat och dynamiskt nätverk där aktörerna är förbundna med varandra på flera olika sätt. Värde uppstår genom relationer, samarbete och informationsutbyte mellan deltagarna. Ett värdenätverk kan till exempel bestå av samarbete mellan företag, aktörer inom den offentliga sektorn, organisationer och individer.\n",
          "@language": "sv"
        },
        {
          "@value": "A value network refers to a set of relationships between actors in which value is created through interaction and exchange among multiple participants. In a value network, organizations, groups, or individuals create both tangible value (e.g. products, services, money) and intangible value (e.g. information, knowledge, trust, and collaboration) for one another.\nUnlike a value chain, a value network is not a linear process but a multidirectional and dynamic network in which actors are connected in multiple ways. Value emerges through relationships, collaboration, and the exchange of information among participants. A value network may consist, for example, of cooperation between companies, public sector actors, organizations, and individuals.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/PAS 24644-1:2023",
          "@language": "en",
          "@id": "https://standards.globalspec.com/std/14629302/pas-24644-1"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/toimitusketju",
        "https://teemualaluusua.github.io/sanasto1/#/concept/asiakastilauksen-kytkeytymiskohta"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-27T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/relaatiotietomalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "relaatiotietomalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "relationsdatamodell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "primary key",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tietomallimuoto, joka muodostuu tauluista, riveistä ja sarakkeista.",
          "@language": "fi"
        },
        {
          "@value": "En datamodellform som består av tabeller, rader och kolumner.",
          "@language": "sv"
        },
        {
          "@value": "A data model format consisting of tables, rows and columns.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "IBM:n kehittämä tietomallimuoto on nykyisin hyvin yleinen. Sen perusosia ovat tietokantataulut, jotka koostuvat riveistä ja sarakkeista. Jokaisessa taulussa on taulun sisäinen, uniikki pääavain, joka erottaa taulun rivit toisistaan. Lisäksi taulussa on toiseen tauluun viittaava viiteavain. Taulujen sisältö voidaan linkittää toisiinsa viiteavaimilla. Nämä taulujen väliset suhteet ovat relaatiotietomallin keskeinen osa.",
          "@language": "fi"
        },
        {
          "@value": "Denna av IBM utvecklade datamodellform är numera mycket vanlig. Dess grundläggande delar är databastabeller, som består av rader och kolumner. Varje tabell har en tabellintern, unik primärnyckel som skiljer tabellens rader åt. Dessutom har tabellen en främmande nyckel som hänvisar till en annan tabell. Tabellernas innehåll kan länkas samman med hjälp av främmande nycklar. Dessa relationer mellan tabellerna är en central del av relationsdatamodellen.",
          "@language": "sv"
        },
        {
          "@value": "This data model format, developed by IBM, is now very common. Its basic components are database tables, consisting of rows and columns. Each table has a table-internal, unique primary key that distinguishes the table's rows from one another. In addition, a table has a foreign key referring to another table. The content of tables can be linked to one another via foreign keys. These relationships between tables are a central part of the relational data model.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RYHTI, Sanasto",
          "@language": "fi",
          "@id": "https://ryhti.syke.fi/ohjeet-ja-tuki/ryhti-sanasto/"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/relaatiotietokanta"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/skeema",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "skeema",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "schema",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "schema",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "rakennekuvaus, jonka mukaisella sanastolla voidaan kuvailla sillä tarkkuudella, että myös tietokoneet ymmärtävät sen",
          "@language": "fi"
        },
        {
          "@value": "strukturdefinition vars vokabulär gör det möjligt att beskriva information med sådan precision att även datorer kan tolka den",
          "@language": "sv"
        },
        {
          "@value": "structural specification that defines a vocabulary enabling information to be described with sufficient precision for computer interpretation",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "looginen suunnitelma, jossa esitetään metatietoelementtien väliset yhteydet\nyleensä määrittämällä säännöt metatietojen käytölle ja hallinnalle erityisesti\nsemantiikan, syntaksin ja arvojen valinnaisuuden (pakollisuusasteen) osalta\n",
          "@language": "fi"
        },
        {
          "@value": "logical plan showing the relationships between metadata elements, normally\nthrough establishing rules for the use and management of metadata specifically\nas regards the semantics, the syntax and the optionality (obligation level) of values\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastot.fi – Yrityksen digitalous",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yritysdigi/concept-2021"
        },
        {
          "@value": "ISO 23081-1:2006",
          "@language": "en",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsiteskeema",
        "https://teemualaluusua.github.io/sanasto1/#/concept/metatietoskeema"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/käsitemalli",
