    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tahtiaika",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tahtiaika",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "taktid",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "takt time",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tahtiaika kuvaa sitä aikaa, jossa tietty työtehtävä on tarkoitus suorittaa.",
          "@language": "fi"
        },
        {
          "@value": "Taktiden beskriver den tid inom vilken en viss arbetsuppgift är avsedd att utföras.",
          "@language": "sv"
        },
        {
          "@value": "Takt time describes the time within which a particular work task is intended to be completed.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RIL, Tahtituotanto:2024",
          "@language": "fi",
          "@id": "https://view.taiqa.com/ril/tahtituotanto-opas-2-2024#/page=1"
        }
      ],
