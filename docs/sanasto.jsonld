    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/epc",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "EPC",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "EPC",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Electronic Product Code",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "EPC on GS1:n standardi RFID:lle. Sillä yksilöidään esimerkiksi logistiset yksiköt, sijainnit ja muut toimitusketjun tiedot RFID-teknologiaan soveltuviksi. EPC:tä voidaan käyttää eri yhteyksissä, esimerkiksi binäärimuodossa RFIDtunnisteisiin koodattuna tai tekstimuodossa tietojen jakamiseksi yritysten järjestelmien välillä.",
          "@language": "fi"
        },
        {
          "@value": "EPC är GS1:s standard för RFID. Med den identifieras till exempel logistiska enheter, platser och andra uppgifter i leveranskedjan så att de lämpar sig för RFID-teknik. EPC kan användas i olika sammanhang, till exempel kodad i binärt format på RFID-taggar eller i textformat för att dela information mellan företagens system.",
          "@language": "sv"
        },
        {
          "@value": "EPC is GS1's standard for RFID. It is used to identify, for example, logistics units, locations and other supply chain information in a form suitable for RFID technology. EPC can be used in various contexts, for example encoded in binary form on RFID tags or in text form to share information between companies' systems.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "GS1 Finland:2025",
          "@language": "fi",
          "@id": "https://gs1.fi/fi/standardit/tunnistamisen-standardit/epcrfid"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/gs1-standardit"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/data-analytiikka",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "data analytiikka",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "dataanalytik",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data analytics",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Data analytiikka on prosessi, jossa analysoidaan, kerätään, järjestetään ja tallennetaan raakadataa liiketoiminnan kannalta merkityksellisten havaintojen saamiseksi.",
          "@language": "fi"
        },
        {
          "@value": "Dataanalytik är en process där rådata analyseras, samlas in, organiseras och lagras för att få fram observationer som är relevanta för affärsverksamheten.",
          "@language": "sv"
        },
        {
          "@value": "Data analytics is a process in which raw data is analyzed, collected, organized and stored in order to obtain observations relevant to business operations.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO/IEC 24668:2022",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "skos:narrower": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tiedon-louhinta"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/big-data"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/projektin-informaatiomalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "projektin informaatiomalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "projektinformationsmodell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "project information model",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "PIR",
          "@language": "en",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "rakennuskohteen informaatiomalli, joka sisältää rakennusprojektin suunnittelu- ja rakennusvaiheen toteutukseen tarvittavat tiedot",
          "@language": "fi"
        },
        {
          "@value": "informationsmodell av byggnadsobjekt som innehåller de uppgifter som behövs för genomförandet av byggprojektets projekterings- och byggskede",
          "@language": "sv"
        },
        {
          "@value": "information model of a construction entity that contains the information needed for carrying out the design and construction stages of a building project",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Projektin informaatiomalli sisältää suunnitelmamallin ja toteumamallin tietojen lisäksi esimerkiksi aikataulutietoja sekä hankintoihin ja työmaalogistiikkaan liittyviä tietoja.",
          "@language": "fi"
        },
        {
          "@value": "Projektin informaatiomalli tukee projektin toteutusta ja vaikuttaa omaisuuskohteen informaatiomalliin. Projektin informaatiomalli tarvitaan myös pitkäaikaista projektiarkistointia ja auditointia varten.",
          "@language": "fi"
        },
        {
          "@value": "Käsitejärjestelmäkaavio: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "fi"
        },
        {
          "@value": "Utöver uppgifterna i projekteringsmodellen och as-built-modellen innehåller projektinformationsmodellen till exempel tidsplaneuppgifter samt uppgifter kopplade till upphandlingar och arbetsplatslogistik.",
          "@language": "sv"
        },
        {
          "@value": "Projektinformationsmodellen stödjer genomförandet av projektet och påverkar tillgångsobjektets informationsmodell. Projektinformationsmodellen behövs även för långsiktig projektarkivering och revision.",
          "@language": "sv"
        },
        {
          "@value": "Begreppssystemschema: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "sv"
        },
        {
          "@value": "In addition to the information in the design model and the as-built model, the project information model contains, for example, schedule information and information related to procurement and site logistics.",
          "@language": "en"
        },
        {
          "@value": "The project information model supports project delivery and affects the asset's information model. The project information model is also needed for long-term project archiving and auditing.",
          "@language": "en"
        },
        {
          "@value": "Concept system diagram: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastokeskus, RY-mallit -sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rymallit/c21"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-informaatiomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/omaisuuskohteen-informaatiomalli",
