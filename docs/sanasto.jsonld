    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/peppol-verkosto",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "Peppol-verkosto",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Peppol-nätverk",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "Peppol network",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "sähköisten sanomien välitysverkosto, joka perustuu yhteisesti sovituille tiedonsiirtotavoille, tietomalleille ja liiketoimintasäännöille",
          "@language": "fi"
        },
        {
          "@value": "nätverk för överföring av elektroniska meddelanden som bygger på gemensamt överenskomna överföringssätt, datamodeller och affärsregler",
          "@language": "sv"
        },
        {
          "@value": "network for exchanging electronic messages based on commonly agreed transmission methods, data models and business rules",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "PEPPOL-verkoston käyttäjät vaihtavat verkostossa keskenään muun muassa\nhankintasanomia, verkkolaskuja ja viranomaisraportteja.\n",
          "@language": "fi"
        },
        {
          "@value": "PEPPOL-verkostoa hallinnoi OpenPEPPOL-yhdistys.\n",
          "@language": "fi"
        },
        {
          "@value": "Användare av PEPPOL-nätverket utbyter bland annat upphandlingsmeddelanden,\ne-fakturor och myndighetsrapporter.\n",
          "@language": "sv"
        },
        {
          "@value": "Users of the PEPPOL network exchange procurement messages, e-invoices\nand regulatory reports.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "YTI – PEPPOL-verkosto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/yritysdigi/concept-2087"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/edi",
        "https://teemualaluusua.github.io/sanasto1/#/concept/finvoice",
