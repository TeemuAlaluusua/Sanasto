    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/avoin-toimintaympäristö",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "avoin toimintaympäristö",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "öppen verksamhetsmiljö",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "open operating environment",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Sovellus, johon riippumattomat osapuolet voivat vapaasti osallistua ja jossa kahdenväliset järjestelyt eivät ole tarpeen.",
          "@language": "fi"
        },
        {
          "@value": "En tillämpning som oberoende parter fritt kan delta i och där bilaterala arrangemang inte behövs.",
          "@language": "sv"
        },
        {
          "@value": "An application which independent parties can freely take part in and where bilateral arrangements are not needed.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Alaluusua, 2023",
          "@language": "fi",
          "@id": "https://aaltodoc.aalto.fi/server/api/core/bitstreams/d55ffacc-a2d7-414b-8f8c-313dff01e984/content"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/suljettu-toimintaympäristö"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/cde",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "yhteinen tietoympäristö",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "gemensam datamiljö",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "common data environment",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "CDE",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "CDE",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "CDE",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "Sovittu informaation lähde minkä tahansa projektin tai omaisuuskohteen\njokaisen informaatiokoosteen keräämiseksi, hallitsemiseksi ja\nlevittämiseksi hallinnoidun prosessin kautta.\n",
          "@language": "fi"
        },
        {
          "@value": "En överenskommen informationskälla för att samla in, hantera och\ndistribuera varje informationsmängd i ett projekt eller en tillgång\ngenom en kontrollerad process.\n",
          "@language": "sv"
        },
        {
          "@value": "Agreed source of information for collecting, managing and\ndisseminating each information container through a managed process\nfor a given project or asset.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Yhteisen tietoympäristön työnkulku kuvaa käytettävät prosessit ja\nyhteisen tietoympäristön (CDE) sovellus voi tarjota näitä prosesseja\ntukevaa teknologiaa.\n",
          "@language": "fi"
        },
        {
          "@value": "Arbetsflödet i den gemensamma datamiljön beskriver de processer\nsom används och CDE-applikationen kan erbjuda teknik som stöder\ndessa processer.\n",
          "@language": "sv"
        },
        {
          "@value": "The workflow of the common data environment describes the processes\nused and the CDE application can provide technology supporting\nthose processes.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN ISO 19650-1:2018"
        },
        {
          "@value": "Suomi.fi terminologia – EN 19650",
          "@id": [
            "https://sanastot.suomi.fi/terminology/en19650/concept/concept-32"
          ]
        }
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/mappaus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "vastaavuusmäärittely",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "mappning",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "mapping",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "mappaus",
          "@language": "fi",
          "termType": "Synonyymi"
        },
        {
          "@value": "semanttinen mappaus",
          "@language": "fi",
          "termType": "Synonyymi"
        },
        {
          "@value": "semantisk mappning",
          "@language": "sv",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Yhteen joukkoon kuuluvan elementin rinnastaminen\ntoisen joukon elementtiin semanttisen vastaavuuden\nperusteella.\n",
          "@language": "fi"
        },
        {
          "@value": "Koppling av ett element i en mängd till ett element\ni en annan mängd baserat på semantisk motsvarighet.\n",
          "@language": "sv"
        },
        {
          "@value": "Assigning an element in one set to an element in\nanother set through semantic correspondence.\n",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Vastaavuusmäärittelyssä selvitetään kahden eri\njoukon elementtien väliset semanttiset vastaavuudet.\n",
          "@language": "fi"
        },
        {
          "@value": "Vid mappning fastställs de semantiska\nmotsvarigheterna mellan element i två olika mängder.\n",
          "@language": "sv"
        },
        {
          "@value": "Mapping establishes the semantic correspondence\nbetween elements of two different sets.\n",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "en",
          "@id": "https://www.iso.org/standard/59743.html"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/ontologia",
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/skeema"
      ],
      "dcterms:created": {
        "@value": "2026-03-05T12:00",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-03-14T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/pim",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "PIM",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "PIM",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "project information model",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Projektin toteutusvaiheeseen liittyvä informaatiomalli PIM on jäsennelty tietoarkisto, jota käytetään päätöksenteossa rakennetun ympäristön kohteissa koko niiden elinkaaren aikana. Projektin informaatiomalli (PIM) voi sisältää projektin toteuttamisen aikana esimerkiksi projektin geometrian yksityiskohtia, laitteistojen sijainteja, projektin suunnittelun aikaisia ominaisuusvaatimuksia, rakentamistavan ja aikatauluja, kustannuksia sekä yksityiskohtia asennetuista järjestelmistä, komponenteista ja laitteistoista, mukaan lukien näiden kunnossapitovaatimuksia.",
          "@language": "fi"
        },
        {
          "@value": "Informationsmodellen för projektets genomförandeskede, PIM, är ett strukturerat informationsarkiv som används för beslutsfattande gällande objekt i den byggda miljön under hela deras livscykel. Projektinformationsmodellen (PIM) kan under projektets genomförande innehålla till exempel detaljer om projektets geometri, placeringar av utrustning, egenskapskrav från projekteringsskedet, byggmetod och tidsplaner, kostnader samt detaljer om installerade system, komponenter och utrustning, inklusive deras underhållskrav.",
          "@language": "sv"
        },
        {
          "@value": "The project information model, PIM, related to the project's delivery phase, is a structured information repository used for decision-making regarding built-environment assets throughout their lifecycle. During project delivery, the project information model (PIM) may contain, for example, details of the project's geometry, equipment locations, property requirements from the design stage, construction method and schedules, costs, and details of installed systems, components and equipment, including their maintenance requirements.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "EN/ISO 19650:2018",
          "@language": "fi",
          "@id": "https://www.iso.org/standard/68078.html"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/informaatiomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/projektin-informaatiomalli"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-tietomallinnus",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "rakennuskohteen tietomallinnus",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "datamodellering av byggnadsobjekt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "data modeling of construction entity",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "tietomallinnus, jonka tuloksena syntyy rakennuskohteen tietomalli",
          "@language": "fi"
        },
        {
          "@value": "datamodellering som resulterar i en datamodell av byggnadsobjektet",
          "@language": "sv"
        },
        {
          "@value": "data modeling that results in a data model of the construction entity",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Käsitejärjestelmäkaavio: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "fi"
        },
        {
          "@value": "Begreppssystemschema: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "sv"
        },
        {
          "@value": "Concept system diagram: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "Sanastokeskus, RY-mallit -sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rymallit/c3"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/tietomallinnus"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-tietomalli"
      ],
      "dcterms:created": {
        "@value": "2025-12-23T14:08",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
