    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/rajapinta",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "rajapinta",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "gränssnitt",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "application programming interface",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "API",
          "@language": "en",
          "termType": "Synonyymi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Rajapinta tarkoittaa kahden järjestelmän välille rakennettua kommunikointiyhteyttä.",
          "@language": "fi"
        },
        {
          "@value": "Med gränssnitt avses en kommunikationsförbindelse som byggts upp mellan två system.",
          "@language": "sv"
        },
        {
          "@value": "An interface refers to a communication connection built between two systems.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RYHTI, Sanasto",
          "@language": "fi",
          "@id": "https://ryhti.syke.fi/ohjeet-ja-tuki/ryhti-sanasto/"
