      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/omaisuuskohteen-informaatiomalli",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "omaisuuskohteen informaatiomalli",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "tillgångsinformationsmodell",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "asset information model",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "AIM",
          "@language": "fi",
          "termType": "Lyhenne"
        },
        {
          "@value": "AIM",
          "@language": "sv",
          "termType": "Lyhenne"
        },
        {
          "@value": "AIM",
          "@language": "en",
          "termType": "Lyhenne"
        }
      ],
      "skos:definition": [
        {
          "@value": "rakennuskohteen informaatiomalli, joka sisältää rakennuskohteen käyttö- ja ylläpitovaiheen aikana tarvittavat tiedot",
          "@language": "fi"
        },
        {
          "@value": "informationsmodell för byggnadsobjekt som innehåller de uppgifter som behövs under byggnadsobjektets användnings- och underhållsskede",
          "@language": "sv"
        },
        {
          "@value": "information model of a built asset that contains the information required during the use and maintenance phase of the built asset",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "Käsitejärjestelmäkaavio: https://sanastokeskus.fi/suomi.fi/rymallit/tietomalli.svg",
          "@language": "fi"
        },
        {
          "@value": "Omaisuuskohteen informaatiomallin sisältö perustuu usein projektin informaatiomalliin, johon kuuluvat esimerkiksi suunnitelma- ja toteumamallin tiedot.",
          "@language": "fi"
        },
        {
          "@value": "Omaisuuskohteen informaatiomalli tukee omaisuudenhallintaa.",
          "@language": "fi"
        },
        {
          "@value": "Innehållet i tillgångsinformationsmodellen baseras ofta på projektets informationsmodell, som till exempel omfattar uppgifter från planerings- och genomförandemodeller.",
          "@language": "sv"
        },
        {
          "@value": "Tillgångsinformationsmodellen stödjer förvaltningen av tillgångar.",
          "@language": "sv"
        },
        {
          "@value": "The content of the asset information model is often based on the project information model, which includes for example information from design and as-built models.",
          "@language": "en"
        },
        {
          "@value": "The asset information model supports asset management.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RY-mallit sanasto",
          "@language": "fi",
          "@id": "https://iri.suomi.fi/terminology/rymallit/c25"
        }
      ],
      "skos:broader": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohteen-informaatiomalli"
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/projektin-informaatiomalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/suunnitelmamalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/toteumamalli",
        "https://teemualaluusua.github.io/sanasto1/#/concept/rakennuskohde"
      ],
      "dcterms:created": {
        "@value": "2025-12-23T14:08",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2025-12-23T14:08",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/koneluettava",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "koneluettava",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "maskinläsbar",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "machine-readable",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tietosisällön esittäminen rakenteellisessa muodossa, esimerkiksi taulukoissa. Koneluettavuudella pyritään yksinkertaistamaan tulkinnanvaraisia asioita sekä yhtenäistämään tiedon muotoa. Tietojärjestelmissä konemuotoista tietoa voidaan yhdistellä olemassa olevaan tietosisältöön, jossa monisanaiset tai tulkinnanvaraiset tietokohteet on korvattu yksiselitteisillä merkinnöillä, koodeilla tai niihin verrattavilla ilmaisuilla. Koneluettavuus on tiedon rakenteellistamista taulukoihin tai muuten jaoteltuihin tiedostoihin, joista ohjelma on helpompi poimia samaan kohteeseen tai asiaan liittyvää tietoa. Oleellista konemuodossa on eri lähteistä tulevien tietojen yhdisteleminen ja yhtenäinen muoto.",
          "@language": "fi"
        },
        {
          "@value": "Presentation av informationsinnehåll i strukturerad form, till exempel i tabeller. Med maskinläsbarhet strävar man efter att förenkla tolkningsbara frågor samt förenhetliga informationens form. I informationssystem kan maskinformad information kombineras med befintligt informationsinnehåll, där mångordiga eller tolkningsbara informationsobjekt har ersatts med entydiga anteckningar, koder eller jämförbara uttryck. Maskinläsbarhet innebär att strukturera information i tabeller eller på annat sätt indelade filer, ur vilka ett program lättare kan hämta information som hänför sig till samma objekt eller sak. Väsentligt i maskinformen är att kombinera information från olika källor till en enhetlig form.",
          "@language": "sv"
        },
        {
          "@value": "Presentation of information content in structured form, for example in tables. Machine-readability aims to simplify matters that are otherwise open to interpretation and to standardize the form of information. In information systems, machine-form data can be combined with existing information content, where verbose or ambiguous data items have been replaced with unambiguous notations, codes or comparable expressions. Machine-readability means structuring information into tables or otherwise categorized files, from which a program can more easily extract information relating to the same object or matter. What is essential in the machine form is combining information from different sources into a uniform format.",
          "@language": "en"
        }
      ],
      "skos:note": [
        {
          "@value": "vrt. ihmisluettava",
          "@language": "fi"
        },
        {
          "@value": "jfr. mänskligt läsbar",
          "@language": "sv"
        },
        {
          "@value": "cf. human-readable",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "RYHTI, Sanasto",
          "@language": "fi",
          "@id": "https://ryhti.syke.fi/ohjeet-ja-tuki/ryhti-sanasto/"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/ihmisluettava",
        "https://teemualaluusua.github.io/sanasto1/#/concept/koneluettavuus"
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-08-28T00:00",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/valintalista",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "valintalista",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "valbar lista",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "pick list",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "Valintalista on digitaalisen graafisen käyttöliittymän elementti, joka tarjoaa käyttäjälle mahdollisuuden valita vaihtoehtoja, kuten termejä valmiilta listalta.",
          "@language": "fi"
        },
        {
          "@value": "En vallista är ett element i ett digitalt grafiskt användargränssnitt som ger användaren möjlighet att välja alternativ, såsom termer, från en fördefinierad lista.",
          "@language": "sv"
        },
        {
          "@value": "A pick list is an element of a digital graphical user interface that allows the user to select options, such as terms, from a predefined list.",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2017",
          "@language": "fi",
          "@id": "https://www.iso.org/"
        }
      ],
      "dcterms:created": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      },
      "dcterms:modified": {
        "@value": "2026-02-24T17:35",
        "@type": "xsd:dateTime"
      }
    },
    {
      "@id": "https://teemualaluusua.github.io/sanasto1/#/concept/tunniste",
      "@type": "skos:Concept",
      "skos:inScheme": "https://teemualaluusua.github.io/sanasto1/sanasto",
      "skos:prefLabel": [
        {
          "@value": "tunniste",
          "@language": "fi",
          "termType": "Suositettava termi"
        },
        {
          "@value": "tagg",
          "@language": "sv",
          "termType": "Suositettava termi"
        },
        {
          "@value": "tag",
          "@language": "en",
          "termType": "Suositettava termi"
        }
      ],
      "skos:definition": [
        {
          "@value": "merkkijono hakemistokirjauksessa, jota käytetään tunnistamaan kenttää tai siihen liittyvää datan kuvailukenttää",
          "@language": "fi"
        },
        {
          "@value": "en teckensträng i en registerpost som används för att identifiera ett fält eller det tillhörande databeskrivningsfältet",
          "@language": "sv"
        },
        {
          "@value": "a character string in an index entry used to identify a field or its associated data description field",
          "@language": "en"
        }
      ],
      "dcterms:source": [
        {
          "@value": "ISO 5127:2022",
          "@language": "fi"
        }
      ],
      "skos:related": [
        "https://teemualaluusua.github.io/sanasto1/#/concept/nimiavaruus",
        "https://teemualaluusua.github.io/sanasto1/#/concept/uri",
